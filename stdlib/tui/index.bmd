// Table constructor
let new_table = table.new_table;
let render_table = table.render_table;

// Progress & Spinner
let new_progress = progress.new_progress_bar;
let render_bar = progress.render_bar;
let render_spinner = progress.render_spinner;

// Data Visualization
let sparkline = chart.sparkline;
