// --- Module Exports ---
let Color = color;
let Style = style;
let Terminal = terminal;
let Border = border;
let Component = component;
let Table = table;
let Progress = progress;
let Chart = chart;
let Tree = tree;
let Input = input;
let Cli = cli;

// --- High-Level Convenience Shortcuts ---

// Color shortcuts
let rgb = color.rgb;
let bg_rgb = color.bg_rgb;
let hex = color.hex;
let bg_hex = color.bg_hex;
let rgb_to_hex = color.rgb_to_hex;
let hex_to_rgb = color.hex_to_rgb;
let gradient = color.gradient;
let RESET = color.RESET;
let BOLD = color.BOLD;
let DIM = color.DIM;
let CYAN = color.CYAN;
let GREEN = color.GREEN;
let RED = color.RED;
let YELLOW = color.YELLOW;
