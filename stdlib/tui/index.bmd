// Terminal shortcuts
let size = terminal.size;
let width = terminal.width;
let height = terminal.height;
let clear = terminal.clear;
let cursor_to = terminal.cursor_to;
let cursor_hide = terminal.cursor_hide;
let cursor_show = terminal.cursor_show;

// Border and Box shortcuts
let box = border.render_box;

// Component shortcuts
let badge = component.badge;
let card = component.card;
let divider = component.divider;
let key_value = component.key_value;
