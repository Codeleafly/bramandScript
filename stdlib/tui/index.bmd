let NEON_ORANGE = color.NEON_ORANGE;

// Style shortcuts
let bold = style.bold;
let dim = style.dim;
let italic = style.italic;
let underline = style.underline;
let strip_ansi = style.strip_ansi;
let visible_len = style.visible_len;
let pad_right = style.pad_right;
let pad_left = style.pad_left;
