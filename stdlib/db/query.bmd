// BramandScript Standard Library :: Query Builder (std/db/query)
// Fluent SQL and in-memory Dataset Query Builder with where clauses, sorting,
// limit/offset pagination, and SQL string generation.

// Check if a single dataset row matches a condition tuple [field, op, val]
let evaluate_query_condition = fn(row, cond) {
    let field = cond[0];
    let op = cond[1];
    let expected = cond[2];
    let actual = row[field];

    if op == "=" || op == "==" {
        return actual == expected;
    }
    if op == "!=" || op == "<>" {
        return actual != expected;
    }
    if op == ">" {
        return actual != null && actual > expected;
    }
    if op == ">=" {
        return actual != null && actual >= expected;
    }
    if op == "<" {
        return actual != null && actual < expected;
    }
    if op == "<=" {
        return actual != null && actual <= expected;
    }
    if op == "IN" || op == "in" {
        if expected == null { return false; }
        let i = 0;
        while i < len(expected) {
            if expected[i] == actual { return true; }
            i = i + 1;
        }
        return false;
    }
    if op == "LIKE" || op == "like" || op == "contains" {
        if actual == null { return false; }
        return contains("" + actual, "" + expected);
    }
    return false;
};

// Simple in-place or return sorted array of hashes by field
let sort_records = fn(records, field, direction) {
    let n = len(records);
    if n <= 1 || field == null {
        return records;
    }
    let is_asc = (direction == "ASC" || direction == "asc");

    // Copy array
    let sorted = [];
    let i = 0;
    while i < n {
        sorted = sorted + [records[i]];
        i = i + 1;
    }

    // Bubble sort for stable small/medium collections
    let a = 0;
    while a < n {
        let b = 0;
        while b < n - a - 1 {
            let val1 = sorted[b][field];
            let val2 = sorted[b + 1][field];
            let should_swap = false;

            if is_asc == true {
                if val1 > val2 { should_swap = true; }
            } else {
                if val1 < val2 { should_swap = true; }
            }

            if should_swap == true {
                let temp = sorted[b];
                sorted[b] = sorted[b + 1];
                sorted[b + 1] = temp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return sorted;
};

// Project specified fields from a record
let project_record = fn(row, field_list) {
    if field_list == null || len(field_list) == 0 {
        return row;
    }
    if len(field_list) == 1 && field_list[0] == "*" {
        return row;
    }
    let projected = {};
    let i = 0;
    while i < len(field_list) {
        let f = field_list[i];
        projected[f] = row[f];
        i = i + 1;
    }
    return projected;
};

// Format SQL literal
let format_sql_literal = fn(val) {
    if val == null { return "NULL"; }
    let t = type(val);
    if t == "STRING" {
        return "'" + val + "'";
    }
    if t == "ARRAY" {
        let elements = [];
        let i = 0;
        while i < len(val) {
            elements = elements + [format_sql_literal(val[i])];
            i = i + 1;
        }
        return "(" + join(elements, ", ") + ")";
    }
    return "" + val;
};

// QueryBuilder struct
struct QueryBuilder {
    table_name,
    selected_fields,
    conditions,
    order_field,
    order_dir,
    limit_count,
    offset_count,

    fn select(field_list) {
        if type(field_list) == "ARRAY" {
            selected_fields = field_list;
        } else {
            selected_fields = ["" + field_list];
        }
    }

    fn where(field, op, val) {
        conditions = conditions + [[field, op, val]];
    }

    fn where_eq(field, val) {
        where(field, "=", val);
    }

    fn where_gt(field, val) {
        where(field, ">", val);
    }

    fn where_lt(field, val) {
        where(field, "<", val);
    }

    fn where_in(field, list) {
        where(field, "IN", list);
    }

    fn order_by(field, direction) {
        order_field = field;
        if direction != null {
            order_dir = to_upper(direction);
        } else {
            order_dir = "ASC";
        }
    }

    fn limit(n) {
        limit_count = n;
    }

    fn offset(n) {
        offset_count = n;
    }

    fn execute(dataset) {
        let records = dataset;
        if records == null { records = []; }

        // 1. Filter conditions
        let filtered = [];
        let i = 0;
        while i < len(records) {
            let row = records[i];
            let matches_all = true;
            let c = 0;
            while c < len(conditions) {
                if evaluate_query_condition(row, conditions[c]) != true {
                    matches_all = false;
                    c = len(conditions);
                } else {
                    c = c + 1;
                }
            }
            if matches_all == true {
                filtered = filtered + [row];
            }
            i = i + 1;
        }

        // 2. Sort
        if order_field != null {
            filtered = sort_records(filtered, order_field, order_dir);
        }

        // 3. Offset and Limit
        let start_idx = 0;
        if offset_count != null && offset_count > 0 {
            start_idx = offset_count;
        }
        let end_idx = len(filtered);
        if limit_count != null && limit_count >= 0 {
            let requested_end = start_idx + limit_count;
            if requested_end < end_idx {
                end_idx = requested_end;
            }
        }

        let paged = [];
        let p = start_idx;
        while p < end_idx && p < len(filtered) {
            paged = paged + [project_record(filtered[p], selected_fields)];
            p = p + 1;
        }
        return paged;
    }

    fn to_sql() {
        let sql = "SELECT ";
        if selected_fields == null || len(selected_fields) == 0 {
            sql = sql + "*";
        } else {
            sql = sql + join(selected_fields, ", ");
        }

        sql = sql + " FROM " + table_name;

        if len(conditions) > 0 {
            let clauses = [];
            let i = 0;
            while i < len(conditions) {
                let cond = conditions[i];
                let field = cond[0];
                let op = cond[1];
                let val_lit = format_sql_literal(cond[2]);
                clauses = clauses + [field + " " + op + " " + val_lit];
                i = i + 1;
            }
            sql = sql + " WHERE " + join(clauses, " AND ");
        }

        if order_field != null {
            sql = sql + " ORDER BY " + order_field + " " + order_dir;
        }

        if limit_count != null {
            sql = sql + " LIMIT " + limit_count;
        }

        if offset_count != null && offset_count > 0 {
            sql = sql + " OFFSET " + offset_count;
        }

        return sql;
    }
}

let from_table = fn(table_name) {
    return QueryBuilder(table_name, ["*"], [], null, "ASC", null, 0);
};

let query = from_table;
