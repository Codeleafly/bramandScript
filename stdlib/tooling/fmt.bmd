// BramandScript Standard Library :: Code Formatter (std/tooling/fmt)
// 100% Native BramandScript source code formatter and style canonicalizer.

import "std/strings" as str_pkg
import "std/io" as io_pkg
import "std/tui/color" as color

let c_cyan = fn(t) { return color.CYAN + str(t) + color.RESET; };
let c_green = fn(t) { return color.GREEN + str(t) + color.RESET; };
let c_yellow = fn(t) { return color.YELLOW + str(t) + color.RESET; };
let c_red = fn(t) { return color.RED + str(t) + color.RESET; };
let c_dim = fn(t) { return color.DIM + str(t) + color.RESET; };
let c_bold = fn(t) { return color.BOLD + str(t) + color.RESET; };

let count_line_net = fn(line) {
    let net = 0;
    let in_str = false;
    let q = "";
    let i = 0;
    let n = len(line);

    while i < n {
        let ch = line[i];
        if ch == "\"" || ch == "`" {
            if !in_str {
                in_str = true;
                q = ch;
            } else if q == ch {
                in_str = false;
            }
        } else if !in_str {
            if ch == "{" || ch == "[" || ch == "(" {
                net = net + 1;
            } else if ch == "}" || ch == "]" || ch == ")" {
                net = net - 1;
            }
        }
        i = i + 1;
    }
    return net;
};

let count_leading_closers = fn(line) {
    let closers = 0;
    let i = 0;
    let n = len(line);
    while i < n {
        let ch = line[i];
        if ch == "}" || ch == "]" || ch == ")" {
            closers = closers + 1;
        } else {
            break;
        }
        i = i + 1;
    }
    return closers;
};

let format_line_spacing = fn(line) {
    let trimmed = trim(line);
    if trimmed == "" {
        return "";
    }
    // Handle comments directly
    if str_pkg.starts_with(trimmed, "//") {
        return trimmed;
    }
    return trimmed;
};

let format_source = fn(source) {
    let lines = split(source, "\n");
    let formatted_lines = [];
    let indent_level = 0;
    let indent_unit = "    ";
    let prev_blank = false;

    let i = 0;
    let n = len(lines);
    while i < n {
        let raw_line = lines[i];
        let trimmed = trim(raw_line);

        if trimmed == "" {
            if !prev_blank && len(formatted_lines) > 0 {
                formatted_lines = formatted_lines + [""];
                prev_blank = true;
            }
            i = i + 1;
            continue;
        }
        prev_blank = false;

        let leading_closers = count_leading_closers(trimmed);
        let current_indent = indent_level - leading_closers;
        if current_indent < 0 {
            current_indent = 0;
        }

        let content = format_line_spacing(trimmed);
        let indented = str_pkg.repeat(indent_unit, current_indent) + content;
        formatted_lines = formatted_lines + [indented];

        let net = count_line_net(trimmed);
        indent_level = indent_level + net;
        if indent_level < 0 {
            indent_level = 0;
        }

        i = i + 1;
    }

    return join(formatted_lines, "\n") + "\n";
};

let format_single_file = fn(filepath, check_only) {
    if !file_exists(filepath) {
        println(c_red("[ERROR] File not found: " + filepath));
        return -1;
    }

    let original = read_file(filepath);
    let formatted = format_source(original);

    if original == formatted {
        return 0;  // Already formatted
    }

    if check_only {
        println("  • " + filepath + c_yellow(" needs formatting"));
        return 1;
    }

    write_file(filepath, formatted);
    println("  " + c_green("[OK]") + " Formatted " + filepath);
    return 1;
};

let run_fmt_cli = fn(paths_list, check_only) {
    if len(paths_list) == 0 {
        paths_list = ["."];
    }

    let files_to_format = [];
    let p_idx = 0;
    while p_idx < len(paths_list) {
        let p = paths_list[p_idx];
        if file_exists(p) {
            if is_dir(p) {
                // Find .bmd files
                let entries = list_dir(p);
                let e_idx = 0;
                while e_idx < len(entries) {
                    let entry = entries[e_idx];
                    if str_pkg.ends_with(entry, ".bmd") {
                        files_to_format = files_to_format + [p + "/" + entry];
                    }
                    e_idx = e_idx + 1;
                }
            } else if str_pkg.ends_with(p, ".bmd") {
                files_to_format = files_to_format + [p];
            }
        }
        p_idx = p_idx + 1;
    }

    if len(files_to_format) == 0 {
        println(c_dim("[INFO] No .bmd files found to format"));
        return 0;
    }

    let changed_count = 0;
    let f_idx = 0;
    while f_idx < len(files_to_format) {
        let f = files_to_format[f_idx];
        let res = format_single_file(f, check_only);
        if res > 0 {
            changed_count = changed_count + 1;
        }
        f_idx = f_idx + 1;
    }

    if check_only {
        if changed_count > 0 {
            println("\n" + c_red("[FAIL] " + str(changed_count) + " file(s) need formatting."));
            return 1;
        } else {
            println(c_green("[OK] All files properly formatted."));
            return 0;
        }
    }

    println("\n" + c_green("[OK] Formatted " + str(changed_count) + " file(s)."));
    return 0;
};
