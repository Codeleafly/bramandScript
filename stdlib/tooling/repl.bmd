// BramandScript Standard Library :: Interactive REPL Engine (std/tooling/repl)
// 100% Native BramandScript REPL with session state, multi-line editing,
// runtime reflection, timing diagnostics, and bytecode disassembly.

import "std/strings" as str_pkg
import "std/tui/color" as color
import "std/tui/style" as style

let c_cyan = fn(t) { return color.CYAN + str(t) + color.RESET; };
let c_green = fn(t) { return color.GREEN + str(t) + color.RESET; };
let c_yellow = fn(t) { return color.YELLOW + str(t) + color.RESET; };
let c_red = fn(t) { return color.RED + str(t) + color.RESET; };
let c_magenta = fn(t) { return color.MAGENTA + str(t) + color.RESET; };
let c_dim = fn(t) { return color.DIM + str(t) + color.RESET; };
let c_bold = fn(t) { return color.BOLD + str(t) + color.RESET; };

let count_delimiter_depth = fn(line) {
    let depth = 0;
    let in_str = false;
    let quote_char = "";
    let i = 0;
    let n = len(line);

    while i < n {
        let ch = line[i];
        if ch == "\"" || ch == "`" {
            if !in_str {
                in_str = true;
                quote_char = ch;
            } else if quote_char == ch {
                in_str = false;
            }
        } else if !in_str {
            if ch == "{" || ch == "[" || ch == "(" {
                depth = depth + 1;
            } else if ch == "}" || ch == "]" || ch == ")" {
                depth = depth - 1;
            }
        }
        i = i + 1;
    }
    return depth;
};

let format_repl_value_depth = fn(val, depth) {
    if depth >= 16 {
        return c_dim("...");
    }
    if val == null {
        return c_dim("null");
    }
    let t = type(val);
    if t == "NULL" {
        return c_dim("null");
    }
    if t == "INTEGER" || t == "FLOAT" || t == "BIG_INT" || t == "BIG_FLOAT" {
        return c_yellow(str(val));
    }
    if t == "STRING" {
        return c_green("\"" + str(val) + "\"");
    }
    if t == "BOOLEAN" {
        return c_magenta(str(val));
    }
    if t == "COMPILED_FUNCTION" || t == "CLOSURE" || t == "BUILTIN" || t == "FUNCTION" {
        return c_cyan(str(val));
    }
    if t == "ERROR" {
        return c_red(str(val));
    }
    if t == "ARRAY" {
        if len(val) == 0 {
            return "[]";
        }
        let items = [];
        let i = 0;
        let n = len(val);
        while i < n {
            items = append(items, format_repl_value_depth(val[i], depth + 1));
            i = i + 1;
        }
        return "[" + join(items, ", ") + "]";
    }
    if t == "HASH" {
        if contains(val, "__struct__") {
            let sname = val["__struct__"];
            let ks = keys(val);
            let fields = [];
            let k_idx = 0;
            while k_idx < len(ks) {
                let k = ks[k_idx];
                if !str_pkg.starts_with(k, "__") {
                    let field_val = val[k];
                    let field_type = type(field_val);
                    if field_type != "CLOSURE" && field_type != "COMPILED_FUNCTION" {
                        let f_val_str = format_repl_value_depth(field_val, depth + 1);
                        fields = append(fields, c_cyan(k) + ": " + f_val_str);
                    }
                }
                k_idx = k_idx + 1;
            }
            if len(fields) == 0 {
                return c_bold(str(sname)) + " {}";
            }
            return c_bold(str(sname)) + " { " + join(fields, ", ") + " }";
        }
        let ks = keys(val);
        if len(ks) == 0 {
            return "{}";
        }
        let pairs = [];
        let k_idx = 0;
        while k_idx < len(ks) {
            let k = ks[k_idx];
            let v_str = format_repl_value_depth(val[k], depth + 1);
            let k_str = c_green("\"" + str(k) + "\"");
            pairs = append(pairs, k_str + ": " + v_str);
            k_idx = k_idx + 1;
        }
        return "{ " + join(pairs, ", ") + " }";
    }
    return str(val);
};

let format_repl_value = fn(val) {
    return format_repl_value_depth(val, 0);
};

let print_repl_help = fn() {
    println(c_cyan("✦ BramandScript REPL Commands:"));
    println(c_dim("────────────────────────────────────────────────────────────────────────────"));
    println("  " + c_bold(":help") + "               Show this command reference");
    println("  " + c_bold(":clear") + "              Clear the terminal screen");
    println("  " + c_bold(":reset") + "              Reset active session variables and constants");
    println("  " + c_bold(":env") + "                Inspect all active variables in current session");
    println("  " + c_bold(":type <expr>") + "        Evaluate expression and inspect its runtime type");
    println("  " + c_bold(":time <expr>") + "        Execute expression and measure execution duration");
    println("  " + c_bold(":disasm <expr>") + "      Disassemble bytecode instructions for expression");
    println("  " + c_bold(":editor") + "             Open multi-line editor (finish with ':done')");
    println("  " + c_bold(":exit, :quit") + "        Exit the BramandScript REPL");
    println(c_dim("────────────────────────────────────────────────────────────────────────────"));
};

let run_editor_mode = fn(sess) {
    println(c_yellow("✦ Entering multi-line editor mode. Type ':done' to execute or ':cancel' to abort."));
    let buffer = "";
    let line_num = 1;
    while true {
        let prompt = c_dim("  " + str(line_num) + " │ ");
        let line = read_line(prompt);
        if line == null || line == ":cancel" {
            println(c_dim("[Editor cancelled]"));
            return null;
        }
        if line == ":done" {
            break;
        }
        buffer = buffer + line + "\n";
        line_num = line_num + 1;
    }

    if trim(buffer) == "" {
        return null;
    }

    let t0 = time_ms();
    let res = eval(buffer, sess);
    let elapsed = time_ms() - t0;
    ensure_newline();

    if type(res) == "ERROR" {
        println(c_red("✦ Runtime Error: ") + str(res));
    } else {
        if res != null {
            println(format_repl_value(res));
        }
        println(c_dim("  · executed in " + str(elapsed) + "ms"));
    }
    ensure_newline();
};

let start_repl = fn() {
    println(c_cyan("✦ ") + c_bold("BramandScript 0.1.1") + c_dim(" · High-Performance Native Bytecode VM"));
    println(c_dim("  Type :help for commands, :editor for multi-line, :exit to quit.\n"));

    let sess = create_session();
    let buffer = "";
    let net_depth = 0;

    while true {
        let prompt = "";
        if net_depth == 0 {
            prompt = c_cyan("✦ ") + c_bold("bmd ") + c_green("❯ ") + "\033[0m";
        } else {
            let indent = str_pkg.repeat("  ", net_depth);
            prompt = c_dim("· ··· ") + indent;
        }

        let line = read_line(prompt);
        if line == null {
            // EOF reached (Ctrl+D)
            println("\n" + c_dim("[Session terminated]"));
            break;
        }

        let trimmed = trim(line);

        // Top-level REPL commands (only when not in nested block)
        if net_depth == 0 {
            if trimmed == ":exit" || trimmed == ":quit" || trimmed == "exit" || trimmed == "quit" {
                println(c_dim("[Goodbye]"));
                break;
            }
            if trimmed == ":clear" {
                print("\033[H\033[2J");
                continue;
            }
            if trimmed == ":reset" {
                sess = create_session();
                buffer = "";
                net_depth = 0;
                println(c_green("[OK] ") + "Session reset successfully.");
                continue;
            }
            if trimmed == ":help" {
                print_repl_help();
                continue;
            }
            if trimmed == ":editor" {
                run_editor_mode(sess);
                continue;
            }
            if trimmed == ":env" {
                let vars = session_vars(sess);
                let var_keys = keys(vars);
                if len(var_keys) == 0 {
                    println(c_dim("  (no active user variables in session)"));
                } else {
                    println(c_cyan("✦ Session Variables (" + str(len(var_keys)) + "):"));
                    let k_idx = 0;
                    while k_idx < len(var_keys) {
                        let k = var_keys[k_idx];
                        let val = vars[k];
                        println("  " + c_bold(k) + " : " + c_magenta(type(val)) + " = " + str(val));
                        k_idx = k_idx + 1;
                    }
                }
                continue;
            }
            if str_pkg.starts_with(trimmed, ":disasm ") {
                let expr = trim(str_pkg.slice(trimmed, 8, len(trimmed)));
                let disassembled = disasm(expr);
                println(disassembled);
                continue;
            }
            if str_pkg.starts_with(trimmed, ":type ") {
                let expr = trim(str_pkg.slice(trimmed, 6, len(trimmed)));
                let res = eval(expr, sess);
                if type(res) == "ERROR" {
                    println(c_red("✦ Error: ") + str(res));
                } else {
                    println(c_magenta(type(res)));
                }
                continue;
            }
            if str_pkg.starts_with(trimmed, ":time ") {
                let expr = trim(str_pkg.slice(trimmed, 6, len(trimmed)));
                let t0 = time_ms();
                let res = eval(expr, sess);
                let elapsed = time_ms() - t0;
                ensure_newline();
                if type(res) == "ERROR" {
                    println(c_red("✦ Error: ") + str(res));
                } else {
                    if res != null {
                        println(format_repl_value(res));
                    }
                    println(c_dim("  · execution duration: " + str(elapsed) + "ms"));
                }
                ensure_newline();
                continue;
            }
        }

        if buffer == "" {
            buffer = line;
        } else {
            buffer = buffer + "\n" + line;
        }

        let delta = count_delimiter_depth(line);
        net_depth = net_depth + delta;
        if net_depth < 0 {
            net_depth = 0;
        }

        // If delimiter depth is closed and trimmed is non-empty, evaluate
        if net_depth == 0 && trimmed != "" {
            let to_eval = buffer;
            buffer = "";

            let res = eval(to_eval, sess);
            ensure_newline();
            if type(res) == "ERROR" {
                println(c_red("✦ Runtime Error: ") + str(res));
            } else if res != null {
                println(format_repl_value(res));
            }
            ensure_newline();
        }
    }
};
