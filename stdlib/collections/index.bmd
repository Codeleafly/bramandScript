// BramandScript Standard Library :: Collections Module (std/collections)
// Functional transformations, aggregations, and array utilities.

let map = fn(arr, transform) {
    let out = [];
    for item in arr {
        push(out, transform(item));
    }
    return out;
};

let filter = fn(arr, predicate) {
    let out = [];
    for item in arr {
        if predicate(item) {
            push(out, item);
        }
    }
    return out;
};

let reduce = fn(arr, accumulator, initial) {
    let res = initial;
    for item in arr {
        res = accumulator(res, item);
    }
    return res;
};

let find = fn(arr, predicate) {
    for item in arr {
        if predicate(item) {
            return item;
        }
    }
    return null;
};

let find_index = fn(arr, predicate) {
    let i = 0;
    while i < len(arr) {
        if predicate(arr[i]) {
            return i;
        }
        i = i + 1;
    }
    return -1;
};

let every = fn(arr, predicate) {
    for item in arr {
        if !predicate(item) {
            return false;
        }
    }
    return true;
};

let some = fn(arr, predicate) {
    for item in arr {
        if predicate(item) {
            return true;
        }
    }
    return false;
};

let contains_item = fn(arr, target) {
    for item in arr {
        if item == target {
            return true;
        }
    }
    return false;
};

let unique = fn(arr) {
    let out = [];
    for item in arr {
        if !contains_item(out, item) {
            push(out, item);
        }
    }
    return out;
};

let flatten = fn(arr) {
    let out = [];
    for item in arr {
        if type(item) == "ARRAY" {
            let sub_flat = flatten(item);
            for sub in sub_flat {
                push(out, sub);
            }
        } else {
            push(out, item);
        }
    }
    return out;
};

let chunk = fn(arr, size) {
    if size <= 0 {
        return [];
    }
    let out = [];
    let cur = [];
    for item in arr {
        push(cur, item);
        if len(cur) == size {
            push(out, cur);
            cur = [];
        }
    }
    if len(cur) > 0 {
        push(out, cur);
    }
    return out;
};

let zip = fn(arr1, arr2) {
    let out = [];
    let l1 = len(arr1);
    let l2 = len(arr2);
    let min_len = l1;
    if l2 < min_len {
        min_len = l2;
    }
    let i = 0;
    while i < min_len {
        push(out, [arr1[i], arr2[i]]);
        i = i + 1;
    }
    return out;
};

let take = fn(arr, n) {
    let out = [];
    let limit = n;
    if limit > len(arr) {
        limit = len(arr);
    }
    let i = 0;
    while i < limit {
        push(out, arr[i]);
        i = i + 1;
    }
    return out;
};

let drop = fn(arr, n) {
    let out = [];
    let i = n;
    while i < len(arr) {
        push(out, arr[i]);
        i = i + 1;
    }
    return out;
};

let count = fn(arr, predicate) {
    let c = 0;
    for item in arr {
        if predicate(item) {
            c = c + 1;
        }
    }
    return c;
};

let reverse_array = fn(arr) {
    let out = [];
    let i = len(arr) - 1;
    while i >= 0 {
        push(out, arr[i]);
        i = i - 1;
    }
    return out;
};

let group_by = fn(arr, key_fn) {
    let groups = {};
    for item in arr {
        let k = key_fn(item);
        if groups[k] == null {
            groups[k] = [item];
        } else {
            push(groups[k], item);
        }
    }
    return groups;
};

// key_by indexes array elements into a hash map where key is determined by key_fn
let key_by = fn(arr, key_fn) {
    let out = {};
    for item in arr {
        let k = key_fn(item);
        out[k] = item;
    }
    return out;
};

// partition splits array into two arrays: [matching, non_matching]
let partition = fn(arr, predicate) {
    let matches = [];
    let non_matches = [];
    for item in arr {
        if predicate(item) {
            push(matches, item);
        } else {
            push(non_matches, item);
        }
    }
    return [matches, non_matches];
};

// flat_map applies transform returning arrays and flattens result by one level
let flat_map = fn(arr, transform) {
    let out = [];
    for item in arr {
        let mapped = transform(item);
        if type(mapped) == "ARRAY" {
            for sub in mapped {
                push(out, sub);
            }
        } else {
            push(out, mapped);
        }
    }
    return out;
};

// compact filters out all null values from array
let compact = fn(arr) {
    let out = [];
    for item in arr {
        if item != null {
            push(out, item);
        }
    }
    return out;
};

// sum_by sums the numeric values extracted by num_fn from each item
let sum_by = fn(arr, num_fn) {
    let total = 0;
    for item in arr {
        total = total + num_fn(item);
    }
    return total;
};

// min_by returns the item with the minimum value determined by num_fn
let min_by = fn(arr, num_fn) {
    if len(arr) == 0 {
        return null;
    }
    let best_item = arr[0];
    let best_val = num_fn(best_item);
    let i = 1;
    while i < len(arr) {
        let cur_val = num_fn(arr[i]);
        if cur_val < best_val {
            best_val = cur_val;
            best_item = arr[i];
        }
        i = i + 1;
    }
    return best_item;
};

// max_by returns the item with the maximum value determined by num_fn
let max_by = fn(arr, num_fn) {
    if len(arr) == 0 {
        return null;
    }
    let best_item = arr[0];
    let best_val = num_fn(best_item);
    let i = 1;
    while i < len(arr) {
        let cur_val = num_fn(arr[i]);
        if cur_val > best_val {
            best_val = cur_val;
            best_item = arr[i];
        }
        i = i + 1;
    }
    return best_item;
};

// frequencies returns a map counting the occurrences of each element
let frequencies = fn(arr) {
    let counts = {};
    for item in arr {
        let k = str(item);
        if counts[k] == null {
            counts[k] = 1;
        } else {
            counts[k] = counts[k] + 1;
        }
    }
    return counts;
};

// difference returns elements from arr1 that are not present in arr2
let difference = fn(arr1, arr2) {
    let out = [];
    for item in arr1 {
        if !contains_item(arr2, item) {
            push(out, item);
        }
    }
    return out;
};

// intersection returns elements present in both arr1 and arr2
let intersection = fn(arr1, arr2) {
    let out = [];
    for item in arr1 {
        if contains_item(arr2, item) && !contains_item(out, item) {
            push(out, item);
        }
    }
    return out;
};

// union returns unique elements combined from both arr1 and arr2
let union = fn(arr1, arr2) {
    let out = [];
    for item in arr1 {
        if !contains_item(out, item) {
            push(out, item);
        }
    }
    for item in arr2 {
        if !contains_item(out, item) {
            push(out, item);
        }
    }
    return out;
};
