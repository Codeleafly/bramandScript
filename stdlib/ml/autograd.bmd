// BramandScript Standard Library :: Neural Network Autograd Engine (std/ml/autograd)
// Scalar reverse-mode automatic differentiation engine (computation graph, backpropagation)
// and deep learning primitives (Neuron, Layer, Multi-Layer Perceptron, Optimizer).

let val_id_counter = 1;

let get_next_val_id = fn() {
    let id = "val_" + val_id_counter;
    val_id_counter = val_id_counter + 1;
    return id;
};

let is_val_node = fn(v) {
    if v != null && type(v) == "HASH" && v["_backward"] != null {
        return true;
    }
    return false;
};

// Forward declare new_value
let new_value = null;

let wrap_value = fn(v) {
    if is_val_node(v) == true {
        return v;
    }
    return new_value(v, [], "");
};

// Value constructor building an autograd computation graph node
new_value = fn(data, _prev, _op) {
    let p_list = [];
    if _prev != null { p_list = _prev; }
    let op_name = "";
    if _op != null { op_name = _op; }

    let node = {
        "id": get_next_val_id(),
        "data": data * 1.0,
        "grad": 0.0,
        "_prev": p_list,
        "_op": op_name,
        "_backward": fn() { return null; }
    };

    node["add"] = fn(other) {
        let other_node = wrap_value(other);
        let out = new_value(node["data"] + other_node["data"], [node, other_node], "+");
        out["_backward"] = fn() {
            node["grad"] = node["grad"] + out["grad"];
            other_node["grad"] = other_node["grad"] + out["grad"];
        };
        return out;
    };

    node["mul"] = fn(other) {
        let other_node = wrap_value(other);
        let out = new_value(node["data"] * other_node["data"], [node, other_node], "*");
        out["_backward"] = fn() {
            node["grad"] = node["grad"] + (other_node["data"] * out["grad"]);
            other_node["grad"] = other_node["grad"] + (node["data"] * out["grad"]);
        };
        return out;
    };

    node["sub"] = fn(other) {
        let other_node = wrap_value(other);
        let out = new_value(node["data"] - other_node["data"], [node, other_node], "-");
        out["_backward"] = fn() {
            node["grad"] = node["grad"] + out["grad"];
            other_node["grad"] = other_node["grad"] - out["grad"];
        };
        return out;
    };

    node["pow_val"] = fn(n) {
        let power_num = n * 1.0;
        let out = new_value(pow(node["data"], power_num), [node], "^");
        out["_backward"] = fn() {
            node["grad"] = node["grad"] + (power_num * pow(node["data"], power_num - 1.0) * out["grad"]);
        };
        return out;
    };

    node["relu"] = fn() {
        let r_val = 0.0;
        if node["data"] > 0.0 {
            r_val = node["data"];
        }
        let out = new_value(r_val, [node], "relu");
        out["_backward"] = fn() {
            if node["data"] > 0.0 {
                node["grad"] = node["grad"] + out["grad"];
            }
        };
        return out;
    };

    node["tanh_val"] = fn() {
        let t = tanh(node["data"]);
        let out = new_value(t, [node], "tanh");
        out["_backward"] = fn() {
            node["grad"] = node["grad"] + ((1.0 - (t * t)) * out["grad"]);
        };
        return out;
    };

    node["neg"] = fn() {
        return node["mul"](-1.0);
    };

    node["backward"] = fn() {
        let topo = [];
        let visited = {};
        visited[node["id"]] = true;
        let stack = [[node, 0]];

        while len(stack) > 0 {
            let top_frame = stack[len(stack) - 1];
            let curr = top_frame[0];
            let child_idx = top_frame[1];
            let children = curr["_prev"];

            if child_idx < len(children) {
                top_frame[1] = child_idx + 1;
                let child = children[child_idx];
                let cid = child["id"];
                if visited[cid] != true {
                    visited[cid] = true;
                    stack = stack + [[child, 0]];
                }
            } else {
                let s_len = len(stack);
                stack = slice(stack, 0, s_len - 1);
                topo = topo + [curr];
            }
        }

        node["grad"] = 1.0;

        let r = len(topo) - 1;
        while r >= 0 {
            let n = topo[r];
            if n["_backward"] != null {
                n._backward();
            }
            r = r - 1;
        }
    };

    return node;
};

let val = fn(x) {
    return new_value(x, [], "");
};

// Neuron struct
struct Neuron {
    weights,
    bias,
    nonlin,

    fn call(inputs) {
        let act = bias;
        let i = 0;
        while i < len(weights) && i < len(inputs) {
            let w = weights[i];
            let x = wrap_value(inputs[i]);
            act = act.add(w.mul(x));
            i = i + 1;
        }

        if nonlin == "relu" {
            return act.relu();
        }
        if nonlin == "tanh" {
            return act.tanh_val();
        }
        return act;
    }

    fn parameters() {
        return weights + [bias];
    }
}

let new_neuron = fn(nin, nonlin) {
    let w = [];
    let i = 0;
    while i < nin {
        // Deterministic pseudo-random initial weights between -0.5 and 0.5
        let init_val = ((i % 5) - 2.0) * 0.2;
        if init_val == 0.0 { init_val = 0.1; }
        w = w + [val(init_val)];
        i = i + 1;
    }
    let b = val(0.0);
    return Neuron(w, b, nonlin);
};

// Layer struct
struct Layer {
    neurons,

    fn call(inputs) {
        let outs = [];
        let i = 0;
        while i < len(neurons) {
            outs = outs + [neurons[i].call(inputs)];
            i = i + 1;
        }
        if len(outs) == 1 {
            return outs[0];
        }
        return outs;
    }

    fn parameters() {
        let params = [];
        let i = 0;
        while i < len(neurons) {
            params = params + neurons[i].parameters();
            i = i + 1;
        }
        return params;
    }
}

let new_layer = fn(nin, nout, nonlin) {
    let neurons = [];
    let i = 0;
    while i < nout {
        neurons = neurons + [new_neuron(nin, nonlin)];
        i = i + 1;
    }
    return Layer(neurons);
};

// Multi-Layer Perceptron (MLP)
struct MLP {
    layers,

    fn call(inputs) {
        let curr = inputs;
        let i = 0;
        while i < len(layers) {
            curr = layers[i].call(curr);
            i = i + 1;
        }
        return curr;
    }

    fn parameters() {
        let params = [];
        let i = 0;
        while i < len(layers) {
            params = params + layers[i].parameters();
            i = i + 1;
        }
        return params;
    }

    fn zero_grad() {
        let params = parameters();
        let i = 0;
        while i < len(params) {
            params[i]["grad"] = 0.0;
            i = i + 1;
        }
    }

    fn step(learning_rate) {
        let params = parameters();
        let i = 0;
        while i < len(params) {
            params[i]["data"] = params[i]["data"] - (learning_rate * params[i]["grad"]);
            i = i + 1;
        }
    }
}

let new_mlp = fn(nin, nouts) {
    let sz = [nin] + nouts;
    let layers = [];
    let i = 0;
    while i < len(nouts) {
        let nonlin = "tanh";
        if i == len(nouts) - 1 {
            nonlin = "linear";
        }
        layers = layers + [new_layer(sz[i], sz[i + 1], nonlin)];
        i = i + 1;
    }
    return MLP(layers);
};

// Mean Squared Error loss function
let mse_loss = fn(predictions, targets) {
    let total_loss = val(0.0);
    let n = len(predictions);
    let i = 0;
    while i < n {
        let pred = wrap_value(predictions[i]);
        let target = wrap_value(targets[i]);
        let diff = pred.sub(target);
        let sq = diff.mul(diff);
        total_loss = total_loss.add(sq);
        i = i + 1;
    }
    return total_loss.mul(1.0 / n);
};

let Value = new_value;
