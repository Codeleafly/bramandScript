// BramandScript Standard Library :: Testing Module (std/testing)
// Complete testing harness assertions and utilities.

let assert_true = fn(condition, msg) {
    if !condition {
        let m = "expected true, got falsy";
        if msg != null { m = str(msg); }
        return assert(false, m);
    }
    return true;
};

let assert_false = fn(condition, msg) {
    if condition {
        let m = "expected false, got truthy";
        if msg != null { m = str(msg); }
        return assert(false, m);
    }
    return true;
};

let assert_null = fn(val, msg) {
    if val != null {
        let m = "expected null, got " + type(val);
        if msg != null { m = str(msg); }
        return assert(false, m);
    }
    return true;
};

let assert_not_null = fn(val, msg) {
    if val == null {
        let m = "expected non-null, got null";
        if msg != null { m = str(msg); }
        return assert(false, m);
    }
    return true;
};

import "./bench.bmd" as bench_mod;
import "./fuzz.bmd" as fuzz_mod;

let bench = bench_mod.run_bench;
let fuzz = fuzz_mod.run_fuzz;
