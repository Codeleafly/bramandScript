// BramandScript REPL :: Value Formatter with Syntax Highlighting
// Renders runtime objects with depth-limited formatting and syntax colors.

import "std/strings" as str_pkg

let c_cyan = fn(t) { return "\033[1;36m" + str(t) + "\033[0m"; };
let c_green = fn(t) { return "\033[1;32m" + str(t) + "\033[0m"; };
let c_yellow = fn(t) { return "\033[1;33m" + str(t) + "\033[0m"; };
let c_red = fn(t) { return "\033[1;31m" + str(t) + "\033[0m"; };
let c_magenta = fn(t) { return "\033[1;35m" + str(t) + "\033[0m"; };
let c_dim = fn(t) { return "\033[2m" + str(t) + "\033[0m"; };
let c_bold = fn(t) { return "\033[1m" + str(t) + "\033[0m"; };

let format_repl_value_depth = fn(val, depth) {
    if depth >= 16 {
        return c_dim("...");
    }
    if val == null {
        return c_dim("null");
    }
    let t = type(val);
    if t == "NULL" {
        return c_dim("null");
    }
    if t == "INTEGER" || t == "FLOAT" || t == "BIG_INT" || t == "BIG_FLOAT" {
        return c_yellow(str(val));
    }
    if t == "STRING" {
        return c_green("\"" + str(val) + "\"");
    }
    if t == "BOOLEAN" {
        return c_magenta(str(val));
    }
    if t == "COMPILED_FUNCTION" || t == "CLOSURE" || t == "BUILTIN" || t == "FUNCTION" {
        return c_cyan(str(val));
    }
    if t == "ERROR" {
        return c_red(str(val));
    }
    if t == "ARRAY" {
        if len(val) == 0 {
            return "[]";
        }
        let items = [];
        let i = 0;
        let n = len(val);
        while i < n {
            items = append(items, format_repl_value_depth(val[i], depth + 1));
            i = i + 1;
        }
        return "[" + join(items, ", ") + "]";
    }
    if t == "HASH" {
        if contains(val, "__struct__") {
            let sname = val["__struct__"];
            let ks = keys(val);
            let fields = [];
            let k_idx = 0;
            while k_idx < len(ks) {
                let k = ks[k_idx];
                if !str_pkg.starts_with(k, "__") {
                    let field_val = val[k];
                    let field_type = type(field_val);
                    if field_type != "CLOSURE" && field_type != "COMPILED_FUNCTION" {
                        let f_val_str = format_repl_value_depth(field_val, depth + 1);
                        fields = append(fields, c_cyan(k) + ": " + f_val_str);
                    }
                }
                k_idx = k_idx + 1;
            }
            if len(fields) == 0 {
                return c_bold(str(sname)) + " {}";
            }
            return c_bold(str(sname)) + " { " + join(fields, ", ") + " }";
        }
        let ks = keys(val);
        if len(ks) == 0 {
            return "{}";
        }
        let pairs = [];
        let k_idx = 0;
        while k_idx < len(ks) {
            let k = ks[k_idx];
            let v_str = format_repl_value_depth(val[k], depth + 1);
            let k_str = c_green("\"" + str(k) + "\"");
            pairs = append(pairs, k_str + ": " + v_str);
            k_idx = k_idx + 1;
        }
        return "{ " + join(pairs, ", ") + " }";
    }
    return str(val);
};

let format_repl_value = fn(val) {
    return format_repl_value_depth(val, 0);
};
