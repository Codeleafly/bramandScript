// BramandScript Standard Library :: HTTPS Ecosystem (std/https)
// 100% Self-Hosted Pure BramandScript HTTPS/1.1 Engine built on top of TLS sockets.
// Provides HTTPS Server, HTTPS Client, and router/middleware integration.

import "std/https/server" as server;
import "std/https/client" as client;
import "std/net/router" as router;
import "std/net/middleware" as middleware;

// --- HTTPS Server Exports ---
let Server = server.Server;
let create_server = server.create_server;

// --- HTTPS Client Exports ---
let request = client.request;
let get = client.get;
let post = client.post;
let put = client.put;
let delete_req = client.delete_req;
let del = client.delete_req;
let delete = client.delete_req;
let patch = client.patch;
let head = client.head;
let parse_url = client.parse_url;

// --- Router & Middleware Interop Exports ---
let Router = router.Router;
let RouteGroup = router.RouteGroup;
let new_router = router.new_router;
let create_router = router.create_router;

let MiddlewarePipeline = middleware.MiddlewarePipeline;
let new_pipeline = middleware.new_pipeline;
let logger = middleware.logger;
let cors = middleware.cors;
let rate_limit = middleware.rate_limit;
let auth_bearer = middleware.auth_bearer;
let recover = middleware.recover;
