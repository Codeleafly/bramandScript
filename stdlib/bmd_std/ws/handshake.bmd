// BramandScript Standard Library :: RFC 6455 WebSocket Handshake (std/ws/handshake)
// 100% Self-Hosted Pure BramandScript implementation of WebSocket handshake protocol.

let WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

// Generates a cryptographically secure 16-byte random Base64 client nonce.
let generate_client_key = fn() {
    let rnd_hex = random_bytes(16);
    return base64_encode(hex_decode(rnd_hex));
};

// Computes Sec-WebSocket-Accept key from client Sec-WebSocket-Key per RFC 6455 Section 4.2.2.
let compute_accept_key = fn(client_key) {
    if (client_key == null || len(client_key) == 0) {
        return "";
    }
    let combined = client_key + WS_GUID;
    let h = sha1(combined, true);
    if (len(h) == 40) {
        return base64_encode(hex_decode(h));
    }
    return base64_encode(h);
};

// Builds HTTP/1.1 101 Switching Protocols response wire format.
let build_server_handshake = fn(accept_key) {
    return "HTTP/1.1 101 Switching Protocols\r\n" +
           "Upgrade: websocket\r\n" +
           "Connection: Upgrade\r\n" +
           "Sec-WebSocket-Accept: " + accept_key + "\r\n\r\n";
};

// Builds HTTP/1.1 GET client WebSocket upgrade request wire format.
let build_client_handshake = fn(host, path = "/", key = null) {
    if (key == null) {
        key = generate_client_key();
    }
    let p = path;
    if (p == null || len(p) == 0) {
        p = "/";
    }
    return "GET " + p + " HTTP/1.1\r\n" +
           "Host: " + host + "\r\n" +
           "Upgrade: websocket\r\n" +
           "Connection: Upgrade\r\n" +
           "Sec-WebSocket-Key: " + key + "\r\n" +
           "Sec-WebSocket-Version: 13\r\n\r\n";
};

// Parses and validates a client WebSocket HTTP upgrade request.
let parse_handshake_request = fn(raw_str) {
    if (raw_str == null || len(raw_str) == 0) {
        return {"valid": false, "error": "Empty request"};
    }

    let double_nl = "\r\n\r\n";
    let sep_len = 4;
    let header_end = -1;
    let i = 0;
    while (i <= len(raw_str) - 4) {
        if (raw_str[i] == "\r" && raw_str[i+1] == "\n" && raw_str[i+2] == "\r" && raw_str[i+3] == "\n") {
            header_end = i;
            break;
        }
        i = i + 1;
    }
    if (header_end < 0) {
        i = 0;
        while (i <= len(raw_str) - 2) {
            if (raw_str[i] == "\n" && raw_str[i+1] == "\n") {
                header_end = i;
                sep_len = 2;
                break;
            }
            i = i + 1;
        }
    }

    let header_part = raw_str;
    if (header_end >= 0) {
        header_part = slice(raw_str, 0, header_end);
    }

    let lines = split(header_part, "\n");
    if (len(lines) == 0) {
        return {"valid": false, "error": "Malformed request"};
    }

    let req_line = trim(lines[0]);
    let req_tokens = split(req_line, " ");
    if (len(req_tokens) < 3) {
        return {"valid": false, "error": "Invalid request line"};
    }

    let method = req_tokens[0];
    let path = req_tokens[1];
    let version = req_tokens[2];

    let headers = {};
    let line_idx = 1;
    while (line_idx < len(lines)) {
        let cur_line = trim(lines[line_idx]);
        if (len(cur_line) > 0) {
            let colon_idx = -1;
            let ci = 0;
            while (ci < len(cur_line)) {
                if (cur_line[ci] == ":") {
                    colon_idx = ci;
                    break;
                }
                ci = ci + 1;
            }
            if (colon_idx > 0) {
                let h_name = to_lower(trim(slice(cur_line, 0, colon_idx)));
                let h_val = trim(slice(cur_line, colon_idx + 1, len(cur_line)));
                headers[h_name] = h_val;
            }
        }
        line_idx = line_idx + 1;
    }

    let up = headers["upgrade"];
    let conn = headers["connection"];
    let ws_key = headers["sec-websocket-key"];
    let ws_ver = headers["sec-websocket-version"];

    let is_ws_up = up != null && to_lower(up) == "websocket";
    let is_conn_up = conn != null && contains(to_lower(conn), "upgrade");
    let has_key = ws_key != null && len(ws_key) > 0;

    let is_valid = method == "GET" && is_ws_up && is_conn_up && has_key;

    return {
        "valid": is_valid,
        "method": method,
        "path": path,
        "version": version,
        "headers": headers,
        "key": ws_key,
        "ws_version": ws_ver
    };
};

// Parses and validates a server HTTP 101 Switching Protocols response.
let parse_handshake_response = fn(raw_str) {
    if (raw_str == null || len(raw_str) == 0) {
        return {"valid": false, "error": "Empty response"};
    }

    let double_nl = "\r\n\r\n";
    let header_end = -1;
    let i = 0;
    while (i <= len(raw_str) - 4) {
        if (raw_str[i] == "\r" && raw_str[i+1] == "\n" && raw_str[i+2] == "\r" && raw_str[i+3] == "\n") {
            header_end = i;
            break;
        }
        i = i + 1;
    }
    if (header_end < 0) {
        i = 0;
        while (i <= len(raw_str) - 2) {
            if (raw_str[i] == "\n" && raw_str[i+1] == "\n") {
                header_end = i;
                break;
            }
            i = i + 1;
        }
    }

    let header_part = raw_str;
    if (header_end >= 0) {
        header_part = slice(raw_str, 0, header_end);
    }

    let lines = split(header_part, "\n");
    if (len(lines) == 0) {
        return {"valid": false, "error": "Malformed response"};
    }

    let status_line = trim(lines[0]);
    let status_tokens = split(status_line, " ");
    if (len(status_tokens) < 2) {
        return {"valid": false, "error": "Invalid status line"};
    }

    let status_code = int(status_tokens[1]);

    let headers = {};
    let line_idx = 1;
    while (line_idx < len(lines)) {
        let cur_line = trim(lines[line_idx]);
        if (len(cur_line) > 0) {
            let colon_idx = -1;
            let ci = 0;
            while (ci < len(cur_line)) {
                if (cur_line[ci] == ":") {
                    colon_idx = ci;
                    break;
                }
                ci = ci + 1;
            }
            if (colon_idx > 0) {
                let h_name = to_lower(trim(slice(cur_line, 0, colon_idx)));
                let h_val = trim(slice(cur_line, colon_idx + 1, len(cur_line)));
                headers[h_name] = h_val;
            }
        }
        line_idx = line_idx + 1;
    }

    let accept_key = headers["sec-websocket-accept"];
    let is_valid = status_code == 101 && accept_key != null;

    return {
        "valid": is_valid,
        "status": status_code,
        "accept_key": accept_key,
        "headers": headers
    };
};
