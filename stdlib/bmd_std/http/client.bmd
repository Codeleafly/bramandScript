// BramandScript Standard Library :: Pure HTTP Client (std/http/client)
// 100% Self-Hosted HTTP/1.1 Client implementation on top of raw TCP sockets (std/net).

import "std/http/parser" as parser;

let starts_with = fn(s, prefix) {
    if (s == null || prefix == null) { return false; }
    if (len(prefix) > len(s)) { return false; }
    return slice(s, 0, len(prefix)) == prefix;
};

// Parse URL into schema, host, port, path, and host_port components
let parse_url = fn(raw_url) {
    let u = trim(raw_url);
    let is_https = false;
    let schema = "http";

    if (starts_with(u, "https://")) {
        is_https = true;
        schema = "https";
        u = slice(u, 8, len(u));
    } else if (starts_with(u, "http://")) {
        u = slice(u, 7, len(u));
    }

    let slash_idx = -1;
    let i = 0;
    while (i < len(u)) {
        if (u[i] == "/") {
            slash_idx = i;
            break;
        }
        i = i + 1;
    }

    let host_port = u;
    let path = "/";
    if (slash_idx >= 0) {
        host_port = slice(u, 0, slash_idx);
        path = slice(u, slash_idx, len(u));
    }

    let host = host_port;
    let default_port = 80;
    if (is_https) { default_port = 443; }
    let port = default_port;

    let colon_idx = -1;
    i = 0;
    while (i < len(host_port)) {
        if (host_port[i] == ":") {
            colon_idx = i;
            break;
        }
        i = i + 1;
    }

    if (colon_idx >= 0) {
        host = slice(host_port, 0, colon_idx);
        let port_str = slice(host_port, colon_idx + 1, len(host_port));
        port = int(port_str);
    }

    return {
        "schema": schema,
        "is_https": is_https,
        "host": host,
        "port": port,
        "path": path,
        "host_port": host_port
    };
};

let request = fn(opts) {
    if (opts == null) { opts = {}; }

    let raw_url = opts["url"];
    if (raw_url == null) {
        return {
            "status": 0,
            "status_text": "Missing URL",
            "headers": {},
            "body": "",
            "json": fn() { return null; }
        };
    }

    let parsed_url = parse_url(raw_url);
    let method = "GET";
    if (opts["method"] != null) { method = to_upper(str(opts["method"])); }

    let timeout_ms = 5000;
    if (opts["timeout"] != null) { timeout_ms = int(opts["timeout"]); }

    let hdrs = {};
    if (opts["headers"] != null) {
        let hk = keys(opts["headers"]);
        let i = 0;
        while (i < len(hk)) {
            let k = hk[i];
            hdrs[k] = opts["headers"][k];
            i = i + 1;
        }
    }

    // Ensure Host header is present
    let has_host = false;
    let hk = keys(hdrs);
    let i = 0;
    while (i < len(hk)) {
        if (to_lower(hk[i]) == "host") {
            has_host = true;
            break;
        }
        i = i + 1;
    }
    if (!has_host) {
        hdrs["Host"] = parsed_url["host_port"];
    }

    // Default Connection: close for single-request HTTP/1.1
    let has_conn = false;
    hk = keys(hdrs);
    i = 0;
    while (i < len(hk)) {
        if (to_lower(hk[i]) == "connection") {
            has_conn = true;
            break;
        }
        i = i + 1;
    }
    if (!has_conn) {
        hdrs["Connection"] = "close";
    }

    // Body serialization
    let body_str = "";
    if (opts["body"] != null) {
        let b_type = type(opts["body"]);
        if (b_type == "HASH" || b_type == "ARRAY") {
            body_str = json_stringify(opts["body"]);
            let has_ct = false;
            hk = keys(hdrs);
            i = 0;
            while (i < len(hk)) {
                if (to_lower(hk[i]) == "content-type") {
                    has_ct = true;
                    break;
                }
                i = i + 1;
            }
            if (!has_ct) {
                hdrs["Content-Type"] = "application/json";
            }
        } else {
            body_str = str(opts["body"]);
        }
    }

    // Connect to target host and port
    let target_addr = parsed_url["host"] + ":" + str(parsed_url["port"]);
    let conn = null;

    if (parsed_url["is_https"]) {
        let tls_opts = {};
        if (opts["insecure_skip_verify"] == true) {
            tls_opts["insecure_skip_verify"] = true;
        }
        conn = tls_dial(target_addr, parsed_url["host"], timeout_ms, tls_opts);
    } else {
        conn = net_dial_tcp(target_addr, timeout_ms);
    }

    if (conn == null || type(conn) == "ERROR") {
        return {
            "status": 0,
            "status_text": "Connection Failed: " + str(conn),
            "headers": {},
            "body": "",
            "json": fn() { return null; }
        };
    }

    // Format RFC 7230 request
    let wire_req = parser.format_request({
        "method": method,
        "path": parsed_url["path"],
        "headers": hdrs,
        "body": body_str
    });

    tcp_set_timeout(conn, timeout_ms);
    let write_res = tcp_write(conn, wire_req);
    if (type(write_res) == "ERROR") {
        tcp_close(conn);
        return {
            "status": 0,
            "status_text": "Write Failed: " + str(write_res),
            "headers": {},
            "body": "",
            "json": fn() { return null; }
        };
    }

    // Read full response until EOF or Content-Length satisfied
    let raw_resp = "";
    while (true) {
        let chunk = tcp_read(conn, 4096);
        if (chunk == null || type(chunk) == "ERROR" || len(chunk) == 0) {
            break;
        }
        raw_resp = raw_resp + chunk;
    }
    tcp_close(conn);

    let parsed_resp = parser.parse_response(raw_resp);
    if (parsed_resp == null) {
        return {
            "status": 0,
            "status_text": "Malformed Response",
            "headers": {},
            "body": raw_resp,
            "json": fn() { return null; }
        };
    }

    return {
        "status": parsed_resp["status"],
        "status_text": parsed_resp["status_text"],
        "headers": parsed_resp["headers"],
        "body": parsed_resp["body"],
        "version": parsed_resp["version"],
        "json": fn() {
            if (len(parsed_resp["body"]) == 0) { return null; }
            return json_parse(parsed_resp["body"]);
        },
        "text": fn() {
            return parsed_resp["body"];
        }
    };
};

let get = fn(url, opts = {}) {
    opts["url"] = url;
    opts["method"] = "GET";
    return request(opts);
};

let post = fn(url, body = "", opts = {}) {
    opts["url"] = url;
    opts["method"] = "POST";
    opts["body"] = body;
    return request(opts);
};

let put = fn(url, body = "", opts = {}) {
    opts["url"] = url;
    opts["method"] = "PUT";
    opts["body"] = body;
    return request(opts);
};

let delete_req = fn(url, opts = {}) {
    opts["url"] = url;
    opts["method"] = "DELETE";
    return request(opts);
};

let patch = fn(url, body = "", opts = {}) {
    opts["url"] = url;
    opts["method"] = "PATCH";
    opts["body"] = body;
    return request(opts);
};

let head = fn(url, opts = {}) {
    opts["url"] = url;
    opts["method"] = "HEAD";
    return request(opts);
};
