// BramandScript Standard Library :: Multi-Dimensional Tensor Engine (std/math/tensor)
// High-performance Tensor struct supporting multi-dimensional shapes, strides,
// matrix multiplication (matmul), 2D transpose, determinant, and matrix inversion.

// Compute strides from shape array
let compute_tensor_strides = fn(shape) {
    let n = len(shape);
    if n == 0 { return []; }
    let strides = [];
    let i = 0;
    while i < n {
        let stride = 1;
        let s = i + 1;
        while s < n {
            stride = stride * shape[s];
            s = s + 1;
        }
        strides = strides + [stride];
        i = i + 1;
    }
    return strides;
};

// Compute total number of elements in shape
let compute_tensor_size = fn(shape) {
    if len(shape) == 0 { return 0; }
    let total = 1;
    let i = 0;
    while i < len(shape) {
        total = total * shape[i];
        i = i + 1;
    }
    return total;
};

// Calculate flat index from multi-dimensional coordinate
let get_flat_index = fn(indices, strides) {
    let flat = 0;
    let i = 0;
    while i < len(indices) && i < len(strides) {
        flat = flat + (indices[i] * strides[i]);
        i = i + 1;
    }
    return flat;
};

// Tensor struct
struct Tensor {
    shape,
    strides,
    data,

    fn get(indices) {
        let idx = get_flat_index(indices, strides);
        return data[idx];
    }

    fn set(indices, val) {
        let idx = get_flat_index(indices, strides);
        data[idx] = val;
    }

    fn reshape(new_shape) {
        let new_size = compute_tensor_size(new_shape);
        if new_size != len(data) {
            return null;
        }
        return Tensor(new_shape, compute_tensor_strides(new_shape), data);
    }

    fn transpose() {
        if len(shape) != 2 {
            return null;
        }
        let rows = shape[0];
        let cols = shape[1];
        let new_data = [];
        let c = 0;
        while c < cols {
            let r = 0;
            while r < rows {
                new_data = new_data + [data[r * cols + c]];
                r = r + 1;
            }
            c = c + 1;
        }
        let new_shape = [cols, rows];
        return Tensor(new_shape, compute_tensor_strides(new_shape), new_data);
    }

    fn scale(scalar) {
        let out_data = [];
        let i = 0;
        while i < len(data) {
            out_data = out_data + [data[i] * scalar];
            i = i + 1;
        }
        return Tensor(shape, strides, out_data);
    }

    fn add(other) {
        let out_data = [];
        let i = 0;
        while i < len(data) {
            out_data = out_data + [data[i] + other.data[i]];
            i = i + 1;
        }
        return Tensor(shape, strides, out_data);
    }

    fn sub(other) {
        let out_data = [];
        let i = 0;
        while i < len(data) {
            out_data = out_data + [data[i] - other.data[i]];
            i = i + 1;
        }
        return Tensor(shape, strides, out_data);
    }

    fn mul(other) {
        let out_data = [];
        let i = 0;
        while i < len(data) {
            out_data = out_data + [data[i] * other.data[i]];
            i = i + 1;
        }
        return Tensor(shape, strides, out_data);
    }

    fn matmul(other) {
        if len(shape) != 2 || len(other.shape) != 2 {
            return null;
        }
        let m = shape[0];
        let k = shape[1];
        let other_k = other.shape[0];
        let n = other.shape[1];
        if k != other_k {
            return null;
        }

        let out_data = [];
        let r = 0;
        while r < m {
            let c = 0;
            while c < n {
                let sum_val = 0.0;
                let i = 0;
                while i < k {
                    let a_val = data[r * k + i];
                    let b_val = other.data[i * n + c];
                    sum_val = sum_val + (a_val * b_val);
                    i = i + 1;
                }
                out_data = out_data + [sum_val];
                c = c + 1;
            }
            r = r + 1;
        }
        let out_shape = [m, n];
        return Tensor(out_shape, compute_tensor_strides(out_shape), out_data);
    }

    fn det() {
        if len(shape) != 2 || shape[0] != shape[1] {
            return null;
        }
        let n = shape[0];
        if n == 1 {
            return data[0];
        }
        if n == 2 {
            return (data[0] * data[3]) - (data[1] * data[2]);
        }
        if n == 3 {
            let a = data[0];
            let b = data[1];
            let c = data[2];
            let d = data[3];
            let e = data[4];
            let f = data[5];
            let g = data[6];
            let h = data[7];
            let k = data[8];
            return a * (e * k - f * h) - b * (d * k - f * g) + c * (d * h - e * g);
        }

        // Gaussian elimination for NxN
        let mat = [];
        let i = 0;
        while i < len(data) {
            mat = mat + [data[i] * 1.0];
            i = i + 1;
        }

        let sign_multiplier = 1.0;
        let p = 0;
        while p < n {
            // Find pivot
            let pivot_row = p;
            let r = p + 1;
            while r < n {
                if abs(mat[r * n + p]) > abs(mat[pivot_row * n + p]) {
                    pivot_row = r;
                }
                r = r + 1;
            }

            if pivot_row != p {
                // Swap rows
                let c = 0;
                while c < n {
                    let temp = mat[p * n + c];
                    mat[p * n + c] = mat[pivot_row * n + c];
                    mat[pivot_row * n + c] = temp;
                    c = c + 1;
                }
                sign_multiplier = sign_multiplier * -1.0;
            }

            let pivot_val = mat[p * n + p];
            if pivot_val == 0.0 {
                return 0.0;
            }

            // Eliminate lower rows
            r = p + 1;
            while r < n {
                let factor = mat[r * n + p] / pivot_val;
                let c = p;
                while c < n {
                    mat[r * n + c] = mat[r * n + c] - factor * mat[p * n + c];
                    c = c + 1;
                }
                r = r + 1;
            }
            p = p + 1;
        }

        let d_total = sign_multiplier;
        let d_i = 0;
        while d_i < n {
            d_total = d_total * mat[d_i * n + d_i];
            d_i = d_i + 1;
        }
        return d_total;
    }

    fn inv() {
        if len(shape) != 2 || shape[0] != shape[1] {
            return null;
        }
        let n = shape[0];

        // Create augmented matrix [A | I]
        let aug = [];
        let r = 0;
        while r < n {
            let row = [];
            let c = 0;
            while c < n {
                row = row + [data[r * n + c] * 1.0];
                c = c + 1;
            }
            c = 0;
            while c < n {
                if r == c {
                    row = row + [1.0];
                } else {
                    row = row + [0.0];
                }
                c = c + 1;
            }
            aug = aug + [row];
            r = r + 1;
        }

        // Gauss-Jordan elimination
        let p = 0;
        while p < n {
            let pivot_row = p;
            let r_idx = p + 1;
            while r_idx < n {
                if abs(aug[r_idx][p]) > abs(aug[pivot_row][p]) {
                    pivot_row = r_idx;
                }
                r_idx = r_idx + 1;
            }

            let temp_row = aug[p];
            aug[p] = aug[pivot_row];
            aug[pivot_row] = temp_row;

            let pivot = aug[p][p];
            if pivot == 0.0 {
                return null; // Singular matrix
            }

            // Scale pivot row
            let col = 0;
            while col < 2 * n {
                aug[p][col] = aug[p][col] / pivot;
                col = col + 1;
            }

            // Eliminate all other rows
            let row_idx = 0;
            while row_idx < n {
                if row_idx != p {
                    let factor = aug[row_idx][p];
                    col = 0;
                    while col < 2 * n {
                        aug[row_idx][col] = aug[row_idx][col] - factor * aug[p][col];
                        col = col + 1;
                    }
                }
                row_idx = row_idx + 1;
            }
            p = p + 1;
        }

        // Extract right half of augmented matrix
        let inv_data = [];
        r = 0;
        while r < n {
            let c = 0;
            while c < n {
                inv_data = inv_data + [aug[r][n + c]];
                c = c + 1;
            }
            r = r + 1;
        }
        return Tensor(shape, strides, inv_data);
    }

    fn sum() {
        let total = 0.0;
        let i = 0;
        while i < len(data) {
            total = total + data[i];
            i = i + 1;
        }
        return total;
    }

    fn mean() {
        if len(data) == 0 { return 0.0; }
        return sum() / len(data);
    }

    fn max() {
        if len(data) == 0 { return null; }
        let max_val = data[0];
        let i = 1;
        while i < len(data) {
            if data[i] > max_val {
                max_val = data[i];
            }
            i = i + 1;
        }
        return max_val;
    }

    fn min() {
        if len(data) == 0 { return null; }
        let min_val = data[0];
        let i = 1;
        while i < len(data) {
            if data[i] < min_val {
                min_val = data[i];
            }
            i = i + 1;
        }
        return min_val;
    }

    fn to_array() {
        if len(shape) == 1 {
            return data;
        }
        if len(shape) == 2 {
            let rows = [];
            let r = 0;
            while r < shape[0] {
                let row = [];
                let c = 0;
                while c < shape[1] {
                    row = row + [data[r * shape[1] + c]];
                    c = c + 1;
                }
                rows = rows + [row];
                r = r + 1;
            }
            return rows;
        }
        return data;
    }
}

// Tensor factory constructors
let tensor = fn(data, shape) {
    return Tensor(shape, compute_tensor_strides(shape), data);
};

let zeros = fn(shape) {
    let size = compute_tensor_size(shape);
    let data = [];
    let i = 0;
    while i < size {
        data = data + [0.0];
        i = i + 1;
    }
    return tensor(data, shape);
};

let ones = fn(shape) {
    let size = compute_tensor_size(shape);
    let data = [];
    let i = 0;
    while i < size {
        data = data + [1.0];
        i = i + 1;
    }
    return tensor(data, shape);
};

let eye = fn(n) {
    let data = [];
    let r = 0;
    while r < n {
        let c = 0;
        while c < n {
            if r == c {
                data = data + [1.0];
            } else {
                data = data + [0.0];
            }
            c = c + 1;
        }
        r = r + 1;
    }
    return tensor(data, [n, n]);
};

let from_array = fn(arr) {
    if len(arr) == 0 {
        return tensor([], [0]);
    }
    if type(arr[0]) == "ARRAY" {
        let rows = len(arr);
        let cols = len(arr[0]);
        let flat = [];
        let r = 0;
        while r < rows {
            let c = 0;
            while c < cols {
                flat = flat + [arr[r][c] * 1.0];
                c = c + 1;
            }
            r = r + 1;
        }
        return tensor(flat, [rows, cols]);
    }
    let flat = [];
    let i = 0;
    while i < len(arr) {
        flat = flat + [arr[i] * 1.0];
        i = i + 1;
    }
    return tensor(flat, [len(arr)]);
};
