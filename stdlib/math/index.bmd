// BramandScript Standard Library :: Math Module (std/math)
// High-performance mathematical constants and functions.

const PI = 3.141592653589793;
const E = 2.718281828459045;
const LN2 = 0.6931471805599453;
const LN10 = 2.302585092994046;
const SQRT2 = 1.4142135623730951;
const EPSILON = 0.0000000000000002220446049250313;

let min = fn(a, b) {
    if a < b {
        return a;
    }
    return b;
};

let max = fn(a, b) {
    if a > b {
        return a;
    }
    return b;
};

let clamp = fn(val, min_val, max_val) {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
};

let sign = fn(x) {
    if x > 0 {
        return 1;
    }
    if x < 0 {
        return -1;
    }
    return 0;
};

let deg_to_rad = fn(deg) {
    return deg * (PI / 180.0);
};

let rad_to_deg = fn(rad) {
    return rad * (180.0 / PI);
};

let is_even = fn(n) {
    return n % 2 == 0;
};

let is_odd = fn(n) {
    return n % 2 != 0;
};

let gcd = fn(a, b) {
    let x = a;
    let y = b;
    if x < 0 { x = -x; }
    if y < 0 { y = -y; }
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    return x;
};

let lcm = fn(a, b) {
    if a == 0 || b == 0 {
        return 0;
    }
    let d = gcd(a, b);
    return (a / d) * b;
};

let factorial = fn(n) {
    if n <= 1 {
        return 1;
    }
    let res = 1;
    let i = 2;
    while i <= n {
        res = res * i;
        i = i + 1;
    }
    return res;
};

let sum = fn(arr) {
    let total = 0;
    for x in arr {
        total = total + x;
    }
    return total;
};

let avg = fn(arr) {
    if len(arr) == 0 {
        return 0.0;
    }
    return sum(arr) / len(arr);
};
