// BramandScript Standard Library :: Compressed Sparse Matrix (std/math/sparse)
// Memory-efficient Compressed Sparse Row (CSR) representation
// for massive sparse linear systems and sparse matrix operations.

struct CSRMatrix {
    rows,
    cols,
    values,
    col_indices,
    row_ptrs,

    fn nnz() {
        return len(values);
    }

    fn get(r, c) {
        if r < 0 || r >= rows || c < 0 || c >= cols {
            return 0.0;
        }
        let start_idx = row_ptrs[r];
        let end_idx = row_ptrs[r + 1];
        let k = start_idx;
        while k < end_idx {
            if col_indices[k] == c {
                return values[k];
            }
            k = k + 1;
        }
        return 0.0;
    }

    fn to_dense() {
        let dense = [];
        let r = 0;
        while r < rows {
            let row = [];
            let c = 0;
            while c < cols {
                row = row + [0.0];
                c = c + 1;
            }
            let start_idx = row_ptrs[r];
            let end_idx = row_ptrs[r + 1];
            let k = start_idx;
            while k < end_idx {
                row[col_indices[k]] = values[k];
                k = k + 1;
            }
            dense = dense + [row];
            r = r + 1;
        }
        return dense;
    }

    fn matmul_vec(v) {
        let res = [];
        let r = 0;
        while r < rows {
            let sum_val = 0.0;
            let start_idx = row_ptrs[r];
            let end_idx = row_ptrs[r + 1];
            let k = start_idx;
            while k < end_idx {
                sum_val = sum_val + (values[k] * v[col_indices[k]]);
                k = k + 1;
            }
            res = res + [sum_val];
            r = r + 1;
        }
        return res;
    }

    fn matmul(B) {
        // Sparse matrix times dense matrix B
        let b_rows = len(B);
        let b_cols = len(B[0]);
        if cols != b_rows {
            return null;
        }
        let res = [];
        let r = 0;
        while r < rows {
            let row = [];
            let c = 0;
            while c < b_cols {
                let sum_val = 0.0;
                let start_idx = row_ptrs[r];
                let end_idx = row_ptrs[r + 1];
                let k = start_idx;
                while k < end_idx {
                    sum_val = sum_val + (values[k] * B[col_indices[k]][c]);
                    k = k + 1;
                }
                row = row + [sum_val];
                c = c + 1;
            }
            res = res + [row];
            r = r + 1;
        }
        return res;
    }

    fn scale(scalar) {
        let new_values = [];
        let i = 0;
        while i < len(values) {
            new_values = new_values + [values[i] * scalar];
            i = i + 1;
        }
        return CSRMatrix(rows, cols, new_values, col_indices, row_ptrs);
    }
}

// Construct CSRMatrix from dense 2D array
let csr_from_dense = fn(matrix) {
    let r_count = len(matrix);
    if r_count == 0 {
        return CSRMatrix(0, 0, [], [], [0]);
    }
    let c_count = len(matrix[0]);
    let values = [];
    let col_indices = [];
    let row_ptrs = [0];

    let r = 0;
    while r < r_count {
        let c = 0;
        while c < c_count {
            let val = matrix[r][c];
            if abs(val) > 0.000000000001 {
                values = values + [val * 1.0];
                col_indices = col_indices + [c];
            }
            c = c + 1;
        }
        row_ptrs = row_ptrs + [len(values)];
        r = r + 1;
    }

    return CSRMatrix(r_count, c_count, values, col_indices, row_ptrs);
};

let csr_to_dense = fn(csr) {
    return csr.to_dense();
};

let csr_matmul_vec = fn(csr, v) {
    return csr.matmul_vec(v);
};

let csr_matmul = fn(csr, B) {
    return csr.matmul(B);
};

// Add two CSR matrices: C = A + B
let csr_add = fn(A, B) {
    if A.rows != B.rows || A.cols != B.cols {
        return null;
    }
    let denseA = A.to_dense();
    let denseB = B.to_dense();
    let sum_dense = [];
    let r = 0;
    while r < A.rows {
        let row = [];
        let c = 0;
        while c < A.cols {
            row = row + [denseA[r][c] + denseB[r][c]];
            c = c + 1;
        }
        sum_dense = sum_dense + [row];
        r = r + 1;
    }
    return csr_from_dense(sum_dense);
};
