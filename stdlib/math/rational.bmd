// BramandScript Standard Library :: Math :: Rational (std/math/rational)
// Exact fractional rational numbers with automatic GCD reduction.

let _gcd = fn(a, b) {
    let x = a;
    let y = b;
    if x < 0 { x = -x; }
    if y < 0 { y = -y; }
    while y != 0 {
        let t = y;
        y = x % y;
        x = t;
    }
    return x;
};

struct Rational {
    num,
    den,

    fn reduce() {
        if den == 0 {
            panic("Rational: denominator cannot be zero");
        }
        if num == 0 {
            den = 1;
            return null;
        }
        let sign = 1;
        if num < 0 {
            if den > 0 { sign = -1; }
        } else if num > 0 {
            if den < 0 { sign = -1; }
        }
        let n = num;
        let d = den;
        if n < 0 { n = -n; }
        if d < 0 { d = -d; }
        let g = _gcd(n, d);
        num = sign * (n / g);
        den = d / g;
        return null;
    }

    fn add(other) {
        let o_num = other.num;
        let o_den = other.den;
        let new_num = (num * o_den) + (o_num * den);
        let new_den = den * o_den;
        let r = Rational(new_num, new_den);
        r.reduce();
        return r;
    }

    fn sub(other) {
        let o_num = other.num;
        let o_den = other.den;
        let new_num = (num * o_den) - (o_num * den);
        let new_den = den * o_den;
        let r = Rational(new_num, new_den);
        r.reduce();
        return r;
    }

    fn mul(other) {
        let new_num = num * other.num;
        let new_den = den * other.den;
        let r = Rational(new_num, new_den);
        r.reduce();
        return r;
    }

    fn div(other) {
        if other.num == 0 {
            panic("Rational: division by zero fraction");
        }
        let new_num = num * other.den;
        let new_den = den * other.num;
        let r = Rational(new_num, new_den);
        r.reduce();
        return r;
    }

    fn pow(exp) {
        if exp == 0 {
            let r = Rational(1, 1);
            return r;
        }
        if exp < 0 {
            let pos_exp = -exp;
            let r = Rational(den ** pos_exp, num ** pos_exp);
            r.reduce();
            return r;
        }
        let r = Rational(num ** exp, den ** exp);
        r.reduce();
        return r;
    }

    fn neg() {
        let r = Rational(-num, den);
        r.reduce();
        return r;
    }

    fn abs() {
        let n = num;
        if n < 0 { n = -n; }
        let r = Rational(n, den);
        r.reduce();
        return r;
    }

    fn inv() {
        if num == 0 {
            panic("Rational: cannot invert zero");
        }
        let r = Rational(den, num);
        r.reduce();
        return r;
    }

    fn cmp(other) {
        let diff = (num * other.den) - (other.num * den);
        if diff > 0 { return 1; }
        if diff < 0 { return -1; }
        return 0;
    }

    fn to_float() {
        return (num * 1.0) / den;
    }

    fn to_string() {
        if den == 1 {
            return str(num);
        }
        return str(num) + "/" + str(den);
    }
}

let rational = fn(n, d) {
    if d == 0 {
        panic("rational: denominator cannot be zero");
    }
    let r = Rational(n, d);
    r.reduce();
    return r;
};

let fraction = fn(n, d) {
    return rational(n, d);
};
