// Task 08: JSON, CSV, Base64, and Cryptography

fn check(name, cond) {
    if cond {
        println("  ✓ [PASS] " + name);
    } else {
        println("  ✗ [FAIL] " + name);
        exit(1);
    }
}

println("✦ TASK 08: JSON, CSV, Base64, and Cryptography");

// 1. JSON parse & stringify
let raw_json = "{\"language\":\"BramandScript\",\"version\":\"0.1.0\",\"active\":true,\"features\":[\"VM\",\"Pratt\",\"AST\"]}";
let parsed = json_parse(raw_json);
check("JSON parse string property", parsed["language"] == "BramandScript");
check("JSON parse boolean property", parsed["active"] == true);
check("JSON parse array property", len(parsed["features"]) == 3);

let stringified = json_stringify(parsed);
check("JSON stringify roundtrip", contains(stringified, "BramandScript") && contains(stringified, "active"));

// 2. CSV parse & stringify with quotes and commas
let csv_text = "id,name,role\n1,\"Doe, Jane\",Engineer\n2,\"Smith, John\",Designer\n";
let parsed_csv = csv_parse(csv_text);
check("CSV row count", len(parsed_csv) == 3); // header + 2 rows
check("CSV quoted comma handling", parsed_csv[1][1] == "Doe, Jane");
check("CSV simple field", parsed_csv[2][2] == "Designer");

let reconstructed_csv = csv_stringify(parsed_csv);
check("CSV stringify output", contains(reconstructed_csv, "Doe, Jane"));

// 3. Base64 encode & decode
let raw_msg = "Hello from BramandScript 2026!";
let encoded_b64 = base64_encode(raw_msg);
check("Base64 encode not empty", len(encoded_b64) > 0);
let decoded_b64 = base64_decode(encoded_b64);
check("Base64 decode matches original", decoded_b64 == raw_msg);

// 4. Cryptographic Hashing: SHA-256 against RFC known-good vector
// SHA-256("hello") = 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
let hash_val = sha256("hello");
check("SHA-256 RFC known-good vector", hash_val == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824");

// 5. HMAC-SHA256
let hmac_val = hmac_sha256("secret-key", "authenticated-payload");
check("HMAC-SHA256 generation (64 hex chars)", len(hmac_val) == 64);

// 6. Cryptographic Secure Random & UUID
let r_bytes = random_bytes(16);
check("CSPRNG random_bytes hex string length (16 bytes = 32 hex chars)", len(r_bytes) == 32);

let r_int = random_int(10, 50);
check("CSPRNG random_int in range [10, 50]", r_int >= 10 && r_int <= 50);

let generated_uuid = uuid();
check("UUID v4 string length is 36", len(generated_uuid) == 36);

println("[OK] All Task 08 JSON, CSV, Base64, and Cryptography checks passed.");
