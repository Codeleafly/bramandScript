// 09_week2_day8_day9_test.bmd - Automated Test Suite for Week 2 Day 8 & Day 9 Features

describe("Day 8 Task 01: Bitwise Operators", fn() {
        test("Bitwise AND, OR, XOR operations", fn() {
                let a = 12;  // 1100 in binary
                let b = 10;  // 1010 in binary

                assert_eq(a & b, 8);  // 1000
                assert_eq(a | b, 14);  // 1110
                assert_eq(a ^ b, 6);  // 0110
        });

        test("Bitwise Shift Left and Right", fn() {
                let x = 1;
                assert_eq(x << 1, 2);
                assert_eq(x << 4, 16);
                assert_eq(16 >> 2, 4);
                assert_eq(64 >> 3, 8);
        });

        test("Bitwise NOT operator", fn() {
                assert_eq(~0, -1);
                assert_eq(~1, -2);
                assert_eq(~(-1), 0);
        });
});

describe("Day 8 Task 02: Raw Byte Buffers & Binary I/O", fn() {
        test("Bytes allocation and indexing", fn() {
                let b = bytes(4);
                assert_eq(len(b), 4);
                b[0] = 72;  // 'H'
                b[1] = 101;  // 'e'
                b[2] = 108;  // 'l'
                b[3] = 111;  // 'o'
                assert_eq(b[0], 72);
                assert_eq(b.to_string(), "Helo");
        });

        test("Bytes from string and array", fn() {
                let b1 = bytes("Bramand");
                assert_eq(len(b1), 7);
                assert_eq(b1[0], 66);  // 'B'

                let b2 = bytes([0xDE, 0xAD, 0xBE, 0xEF]);
                assert_eq(len(b2), 4);
                assert_eq(b2.to_hex(), "deadbeef");
        });

        test("Binary integer read and write operations", fn() {
                let buf = bytes(8);
                buf.write_u8(0, 250);
                assert_eq(buf.read_u8(0), 250);

                buf.write_u16(1, 0xABCD, "be");
                assert_eq(buf.read_u16(1, "be"), 0xABCD);

                buf.write_u16(3, 0x1234, "le");
                assert_eq(buf.read_u16(3, "le"), 0x1234);

                let buf32 = bytes(8);
                buf32.write_u32(0, 12345678, "be");
                assert_eq(buf32.read_u32(0, "be"), 12345678);
        });

        test("Bytes slice operation", fn() {
                let b = bytes("Antigravity");
                let sub = slice(b, 0, 4);
                assert_eq(str(sub), "Anti");
                assert_eq(len(sub), 4);
        });
});

describe("Day 8 Task 03: Unicode Code Point & Rune Primitives", fn() {
        test("ord and chr primitives", fn() {
                assert_eq(ord("A"), 65);
                assert_eq(ord("z"), 122);
                assert_eq(ord("✦"), 10022);

                assert_eq(chr(65), "A");
                assert_eq(chr(122), "z");
                assert_eq(chr(10022), "✦");

                assert_eq(chr(ord("X")), "X");
        });
});

describe("Day 8 Task 04: In-Memory Dynamic Code Evaluation", fn() {
        test("Dynamic eval expressions", fn() {
                let result = eval("10 * 20 + 5");
                assert_eq(result, 205);

                let strRes = eval("str(len([1, 2, 3, 4]))");
                assert_eq(strRes, "4");

                let logicRes = eval("let a = 100; let b = 200; if a < b { true } else { false }");
                assert_eq(logicRes, true);
        });
});

describe("Day 9 Task 05: Enum Declarations & Tagged Values", fn() {
        test("Enum basic and auto-increment values", fn() {
                enum Color { RED, GREEN, BLUE }
                assert_eq(Color.RED, 0);
                assert_eq(Color.GREEN, 1);
                assert_eq(Color.BLUE, 2);
                assert_eq(Color.__name__, "Color");
                assert_eq(Color.__enum__, true);
        });

        test("Enum custom integer and string values", fn() {
                enum HttpCode {
                    OK = 200,
                    CREATED = 201,
                    BAD_REQUEST = 400,
                    NOT_FOUND = 404
                }
                assert_eq(HttpCode.OK, 200);
                assert_eq(HttpCode.CREATED, 201);
                assert_eq(HttpCode.BAD_REQUEST, 400);
                assert_eq(HttpCode.NOT_FOUND, 404);

                enum Env {
                    DEV = "development",
                    PROD = "production"
                }
                assert_eq(Env.DEV, "development");
                assert_eq(Env.PROD, "production");
        });
});

describe("Day 9 Task 06: Struct Composition & Field Embedding", fn() {
        test("Struct embedding delegating fields and methods", fn() {
                struct Speaker {
                    greeting,
                    fn speak(target) {
                        return greeting + " " + target;
                    }
                }

                struct Bot {
                    embed Speaker,
                    id,
                    fn status() {
                        return "Bot#" + str(id) + " active";
                    }
                }

                let spk = Speaker("Welcome");
                let b = Bot(spk, 7);

                assert_eq(b.id, 7);
                assert_eq(b.status(), "Bot#7 active");
                // Delegated field
                assert_eq(b.greeting, "Welcome");
                // Delegated method
                assert_eq(b.speak("Developer"), "Welcome Developer");
        });
});

describe("Day 9 Task 07: Callable Struct Instances & Magic Methods", fn() {
        test("Callable struct instance with __call__", fn() {
                struct Adder {
                    base,
                    fn __call__(num) {
                        return base + num;
                    }
                }

                let addTen = Adder(10);
                assert_eq(addTen(25), 35);
                assert_eq(addTen(100), 110);
        });

        test("Custom string representation with __str__", fn() {
                struct Point {
                    x,
                    y,
                    __str__
                }

                let pt = Point(12, 34, "Point(12, 34)");
                assert_eq(str(pt), "Point(12, 34)");
        });
});

describe("Day 9 Task 08: Interface Checking & Structural Duck Typing", fn() {
        test("implements validation on objects", fn() {
                let server = {
                    "start": fn() { return true; },
                    "stop": fn() { return true; },
                    "port": 8080
                };

                assert_eq(implements(server, "start"), true);
                assert_eq(implements(server, ["start", "stop", "port"]), true);
                assert_eq(implements(server, ["start", "restart"]), false);
        });

        test("implements on struct instances with embedding", fn() {
                struct Reader {
                    fn read() { return "data"; }
                }
                struct FileStream {
                    embed Reader,
                    path,
                    fn close() { return true; }
                }

                let r = Reader();
                let fs = FileStream(r, "/tmp/test.txt");

                assert_eq(implements(fs, ["read", "close", "path"]), true);
                assert_eq(implements(fs, "write"), false);
        });
});
