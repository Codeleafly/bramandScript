// BramandScript System Verification :: Week 5 Day 33 SQL & Columnar DataFrame Test Suite
// Validates In-Memory Relational SQL Parser, Query Planner, Relational Query Engine (Joins, Aggregates),
// and Columnar DataFrame Projection & Vectorized Aggregations.

import "std/sql" as sql;
import "std/dataframe" as df_mod;

describe("Day 33: In-Memory Relational SQL Parser & Query Planner", fn() {
    test("parses ANSI SQL queries into AST and plans execution", fn() {
        let ast = sql.parse("SELECT id, name FROM users WHERE id > 10;");
        assert_true(ast != null);
        assert_eq(ast["type"], "SELECT");
        assert_true(ast["valid"]);

        let query_plan = sql.plan(ast);
        assert_true(query_plan != null);
        assert_true(len(query_plan["stages"]) > 0);
    });
});

describe("Day 33: Relational Query Engine Execution", fn() {
    test("executes SELECT with WHERE, ORDER BY, and LIMIT", fn() {
        let employees = [
            { "id": 1, "name": "Alice", "dept": "Engineering", "salary": 120000 },
            { "id": 2, "name": "Bob", "dept": "Sales", "salary": 75000 },
            { "id": 3, "name": "Charlie", "dept": "Engineering", "salary": 110000 },
            { "id": 4, "name": "Diana", "dept": "Marketing", "salary": 85000 }
        ];

        let res = sql.query("SELECT name, salary FROM employees WHERE salary >= 85000 ORDER BY salary DESC LIMIT 2", { "employees": employees });
        assert_eq(len(res), 2);
        assert_eq(res[0]["name"], "Alice");
        assert_eq(res[1]["name"], "Charlie");
    });

    test("executes SQL aggregations and GROUP BY with HAVING", fn() {
        let products = [
            { "category": "Tech", "price": 1000 },
            { "category": "Tech", "price": 500 },
            { "category": "Books", "price": 20 },
            { "category": "Books", "price": 30 },
            { "category": "Home", "price": 150 }
        ];

        let res = sql.query("SELECT category, COUNT(*) as cnt, SUM(price) as total_price, AVG(price) as avg_price FROM products GROUP BY category HAVING cnt > 1 ORDER BY category ASC", { "products": products });
        assert_eq(len(res), 2);
        assert_eq(res[0]["category"], "Books");
        assert_eq(res[0]["cnt"], 2);
        assert_eq(res[0]["total_price"], 50);

        assert_eq(res[1]["category"], "Tech");
        assert_eq(res[1]["cnt"], 2);
        assert_eq(res[1]["total_price"], 1500);
        assert_eq(res[1]["avg_price"], 750);
    });

    test("executes relational INNER JOIN and LEFT JOIN", fn() {
        let customers = [
            { "id": 1, "name": "Alice" },
            { "id": 2, "name": "Bob" },
            { "id": 3, "name": "Charlie" }
        ];

        let orders = [
            { "order_id": 101, "customer_id": 1, "amount": 250 },
            { "order_id": 102, "customer_id": 1, "amount": 150 },
            { "order_id": 103, "customer_id": 2, "amount": 300 }
        ];

        let inner_res = sql.query("SELECT c.name, o.amount FROM customers c INNER JOIN orders o ON c.id = o.customer_id ORDER BY o.order_id ASC", { "customers": customers, "orders": orders });
        assert_eq(len(inner_res), 3);
        assert_eq(inner_res[0]["c.name"], "Alice");
        assert_eq(inner_res[0]["o.amount"], 250);
        assert_eq(inner_res[2]["c.name"], "Bob");

        let left_res = sql.query("SELECT c.name, o.amount FROM customers c LEFT JOIN orders o ON c.id = o.customer_id ORDER BY c.id ASC", { "customers": customers, "orders": orders });
        assert_eq(len(left_res), 4);
        assert_eq(left_res[3]["c.name"], "Charlie");
        assert_eq(left_res[3]["o.amount"], null);
    });

    test("database abstraction supports query, insert, and table inspection", fn() {
        let db = sql.create_database({
            "users": [{ "id": 1, "username": "admin" }]
        });
        db.insert("users", { "id": 2, "username": "guest" });
        assert_eq(len(db.table("users")), 2);

        let res = db.query("SELECT username FROM users WHERE id = 2");
        assert_eq(len(res), 1);
        assert_eq(res[0]["username"], "guest");
    });
});

describe("Day 33: Columnar DataFrame Projection & Vectorized Aggregations", fn() {
    test("converts DataFrame to columnar format and reconstructs from columnar", fn() {
        let col_data = {
            "sku": ["SKU1", "SKU2", "SKU3"],
            "stock": [50, 100, 20]
        };
        let df = df_mod.from_columnar(col_data);
        assert_eq(df.shape()[0], 3);
        assert_eq(df.shape()[1], 2);

        let columnar = df.to_columnar();
        assert_eq(len(columnar["sku"]), 3);
        assert_eq(columnar["stock"][1], 100);
    });

    test("performs vectorized column arithmetic and aggregations", fn() {
        let records = [
            { "val": 10.0 },
            { "val": 20.0 },
            { "val": 30.0 }
        ];
        let df = df_mod.from_records(records);
        let col = df.column("val");
        assert_eq(col.sum(), 60.0);
        assert_eq(col.mean(), 20.0);
        assert_eq(col.min(), 10.0);
        assert_eq(col.max(), 30.0);

        let mask = col.gt(15.0);
        let filtered = df.filter_mask(mask);
        assert_eq(filtered.shape()[0], 2);
    });

    test("executes SQL queries directly on DataFrame", fn() {
        let items = [
            { "name": "Apple", "price": 2.5 },
            { "name": "Banana", "price": 1.2 },
            { "name": "Cherry", "price": 4.0 }
        ];
        let df = df_mod.from_records(items);
        let q_res = df.query("SELECT name, price FROM df WHERE price > 2.0 ORDER BY price DESC");
        assert_eq(q_res.shape()[0], 2);
        assert_eq(q_res.rows[0]["name"], "Cherry");
        assert_eq(q_res.rows[1]["name"], "Apple");
    });
});
