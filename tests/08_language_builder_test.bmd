// 08_language_builder_test.bmd - Regression Tests for Engine Fixes & Systems Primitives

import "std/collections" as coll
import "std/io" as io
import "std/testing" as t

describe("Slice Negative Indexing & Edge Cases", fn() {
    test("Array negative slice indexing", fn() {
        let arr = [10, 20, 30, 40, 50];
        let tail = slice(arr, -2);
        assert_eq(len(tail), 2);
        assert_eq(tail[0], 40);
        assert_eq(tail[1], 50);

        let mid = slice(arr, 1, -1);
        assert_eq(len(mid), 3);
        assert_eq(mid[0], 20);
        assert_eq(mid[2], 40);
    });

    test("String negative slice indexing", fn() {
        let text = "BramandScript";
        let ending = slice(text, -6);
        assert_eq(ending, "Script");

        let middle = slice(text, 0, 7);
        assert_eq(middle, "Bramand");
    });
});

describe("Base64 Whitespace & Crypto Resiliency", fn() {
    test("Base64 decode with surrounding whitespace and newlines", fn() {
        let encoded = "  SGVsbG8gV29ybGQ= \n";
        let decoded = base64_decode(encoded);
        assert_eq(decoded, "Hello World");

        let url_enc = "  SGVsbG8tV29ybGQ \n";
        let url_dec = base64_url_decode(url_enc);
        assert_eq(url_dec, "Hello-World");
    });
});

describe("Numeric Operators & Float Modulo", fn() {
    test("Float modulo operator evaluates correctly", fn() {
        let rem1 = 5.5 % 2.0;
        assert(rem1 >= 1.49 && rem1 <= 1.51, "5.5 % 2.0 must be ~1.5");

        let rem2 = 10 % 3.5;
        assert(rem2 >= 2.99 && rem2 <= 3.01, "10 % 3.5 must be ~3.0");
    });

    test("Integer division overflow protection", fn() {
        // Normal division operates cleanly
        let d = 100 / 5;
        assert_eq(d, 20);
    });
});

describe("Standard Library Enhancements", fn() {
    test("std/collections recursive flatten", fn() {
        let nested = [1, [2, [3, [4, 5]]], 6];
        let flat = coll.flatten(nested);
        assert_eq(len(flat), 6);
        assert_eq(flat[0], 1);
        assert_eq(flat[3], 4);
        assert_eq(flat[5], 6);
    });

    test("std/testing assertions pass cleanly", fn() {
        t.assert_true(true, "must be true");
        t.assert_false(false, "must be false");
        t.assert_null(null, "must be null");
        t.assert_not_null(123, "must be non-null");
    });
});

describe("Subprocess Command Tokenization", fn() {
    test("exec with single space-delimited string", fn() {
        let res = exec("echo hello_world");
        assert_eq(res.code, 0);
        assert(contains(res.stdout, "hello_world"), "stdout contains token");
    });
});
