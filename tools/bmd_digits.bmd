// bmd-digits — lightweight decimal digit-count estimator.
// Run: bmd run tools/bmd_digits.bmd
// Input: a positive integer, or a right-associative power chain using **.
//
// It never evaluates the expression and never constructs the huge result.
// Large power towers are represented symbolically.

let is_digits = fn(value) {
    if len(value) == 0 {
        return false
    }
    let remaining = value
    let digit_index = 0
    let digits = "0123456789"
    while digit_index < 10 {
        remaining = replace(remaining, substring(digits, digit_index, digit_index + 1), "")
        digit_index = digit_index + 1
    }
    return len(remaining) == 0
}

println("bmd-digits — decimal digit estimator")
let expression = trim(read_line("Expression: "))

if len(expression) == 0 {
    eprintln("Error: expression is empty.")
    exit(1)
}

let parts = split(expression, "**")
let base_text = trim(parts[0])

if !is_digits(base_text) {
    eprintln("Error: use positive integer literals only.")
    exit(1)
}

if len(parts) == 1 {
    // For a decimal integer literal, digit count is its text length.
    // This avoids converting it to a machine integer or BigInt.
    let first_nonzero = 0
    while first_nonzero < len(base_text) && substring(base_text, first_nonzero, first_nonzero + 1) == "0" {
        first_nonzero = first_nonzero + 1
    }
    if first_nonzero == len(base_text) {
        println("1 digit")
    } else {
        println(str(len(base_text) - first_nonzero) + " digits")
    }
} else {
    let token_index = 1
    while token_index < len(parts) {
        if !is_digits(trim(parts[token_index])) {
            eprintln("Error: every power must be a non-negative integer literal.")
            exit(1)
        }
        token_index = token_index + 1
    }

    if len(base_text) > 15 {
        eprintln("Error: first-version base must fit in 15 characters.")
        exit(1)
    }

    let base = float(base_text)
    if base <= 1.0 {
        eprintln("Error: base must be greater than 1.")
        exit(1)
    }

    if len(parts) == 2 && len(trim(parts[1])) <= 15 {
        let exponent = float(trim(parts[1]))
        if !is_digits(trim(parts[1])) {
            eprintln("Error: exponent must be non-negative.")
            exit(1)
        }

        // digits(b**e) = floor(e * log10(b)) + 1.
        let digit_estimate = floor(exponent * log10(base)) + 1
        if digit_estimate < 1000 {
            println(str(digit_estimate) + " digits")
        } else if digit_estimate < 1000000 {
            println(str(round(digit_estimate / 1000)) + " thousand digits (approx.)")
        } else if digit_estimate < 1000000000 {
            println(str(round(digit_estimate / 1000000)) + " million digits (approx.)")
        } else if digit_estimate < 1000000000000 {
            println(str(round(digit_estimate / 1000000000)) + " billion digits (approx.)")
        } else if digit_estimate < 1000000000000000 {
            println(str(round(digit_estimate / 1000000000000)) + " trillion digits (approx.)")
        } else {
            println("approximately " + str(digit_estimate) + " digits")
        }
    } else {
        // ** is right-associative in BramandScript:
        // a**b**c means a**(b**c).
        // Therefore log10(a**tower) = log10(a) * tower.
        // Keep the tower as text: do not calculate or allocate it.
        let exponent_expression = ""
        let i = 1
        while i < len(parts) {
            if i > 1 {
                exponent_expression = exponent_expression + "**"
            }
            exponent_expression = exponent_expression + trim(parts[i])
            i = i + 1
        }

        println("Approximately " + str(log10(base)) + " × (" + exponent_expression + ") digits")
        println("Symbolic estimate: digit count is too large for million/billion/trillion naming.")
    }
}
