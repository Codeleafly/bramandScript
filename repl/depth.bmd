// BramandScript REPL :: Delimiter Depth Tracker
// Tracks unclosed braces, brackets, and parentheses to support multi-line input.

let count_delimiter_depth = fn(line) {
    let depth = 0;
    let in_str = false;
    let quote_char = "";
    let i = 0;
    let n = len(line);

    while i < n {
        let ch = line[i];
        if ch == "\"" || ch == "`" {
            if !in_str {
                in_str = true;
                quote_char = ch;
            } else if quote_char == ch {
                in_str = false;
            }
        } else if !in_str {
            if ch == "{" || ch == "[" || ch == "(" {
                depth = depth + 1;
            } else if ch == "}" || ch == "]" || ch == ")" {
                depth = depth - 1;
            }
        }
        i = i + 1;
    }
    return depth;
};
