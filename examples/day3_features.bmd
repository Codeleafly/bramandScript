// BramandScript Day 3 Feature Showcase

// 1. Structs and Methods
struct Person {
    name, age
    fn greet() {
        return "Hello! I am " + name + " and I am " + str(age) + " years old."
    }
}

let p = Person("Aryan", 14)
print(p.greet())

// 2. Mutable Dot Access & Index Assignment
p.age = 15
print("Updated Age:", p.age)

let list = [10, 20, 30]
list[1] = 99
print("Mutated Array:", list)

// 3. For-In Loops with Break & Continue
print("Iterating over array:")
for idx, val in list {
    print("  Index:", idx, "Value:", val)
}

// 4. Pattern Matching
let httpCode = 200
let statusMessage = match httpCode {
    case 200 => { "Success OK" }
    case 404 => { "Resource Not Found" }
    default => { "Server Response" }
}
print("HTTP Match:", statusMessage)

// 5. Array Utilities
let nums = [1, 2, 3]
push(nums, 4)
print("Contains 3?", contains(nums, 3))
print("Contains 99?", contains(nums, 99))
print("Popped:", pop(nums))
print("Array after pop:", nums)
