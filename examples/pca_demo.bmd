// BramandScript Example :: Principal Component Analysis (PCA)
// Demonstrating spectral matrix decomposition, covariance analysis,
// and dimensionality reduction on multidimensional datasets.

import "std/math/decomp" as decomp;
import "std/math/eigen" as eigen;

let matrix_zeros = decomp.matrix_zeros;
let matrix_mult = decomp.matrix_mult;
let matrix_transpose = decomp.matrix_transpose;
let eigen_qr = eigen.eigen_qr;

println("✦ BramandScript Principal Component Analysis (PCA) Demo");
println("─────────────────────────────────────────────────────────");

// Synthetic 2D dataset: correlated x and y points
let data = [
    [2.5, 2.4],
    [0.5, 0.7],
    [2.2, 2.9],
    [1.9, 2.2],
    [3.1, 3.0],
    [2.3, 2.7],
    [2.0, 1.6],
    [1.0, 1.1],
    [1.5, 1.6],
    [1.1, 0.9]
];

let n_samples = len(data);
let n_features = len(data[0]);

println("Input samples: " + str(n_samples) + ", Features: " + str(n_features));

// Step 1: Compute feature means
let means = [0.0, 0.0];
let i = 0;
while i < n_samples {
    means[0] = means[0] + data[i][0];
    means[1] = means[1] + data[i][1];
    i = i + 1;
}
means[0] = means[0] / (n_samples * 1.0);
means[1] = means[1] / (n_samples * 1.0);

println("Mean vector: [" + str(round(means[0] * 1000.0) / 1000.0) + ", " + str(round(means[1] * 1000.0) / 1000.0) + "]");

// Step 2: Center data
let centered = [];
i = 0;
while i < n_samples {
    let row = [
        data[i][0] - means[0],
        data[i][1] - means[1]
    ];
    centered = centered + [row];
    i = i + 1;
}

// Step 3: Compute Covariance Matrix: C = (1 / (N - 1)) * X^T * X
let Xt = matrix_transpose(centered);
let XtX = matrix_mult(Xt, centered);

let cov = matrix_zeros(n_features, n_features);
let r = 0;
while r < n_features {
    let c = 0;
    while c < n_features {
        cov[r][c] = XtX[r][c] / ((n_samples - 1) * 1.0);
        c = c + 1;
    }
    r = r + 1;
}

println("Covariance Matrix:");
println("  [" + str(round(cov[0][0] * 1000.0) / 1000.0) + ", " + str(round(cov[0][1] * 1000.0) / 1000.0) + "]");
println("  [" + str(round(cov[1][0] * 1000.0) / 1000.0) + ", " + str(round(cov[1][1] * 1000.0) / 1000.0) + "]");

// Step 4: Spectral Decomposition (Eigenvalues & Eigenvectors)
let spectral = eigen_qr(cov, 100, 0.00000001);
let eigenvalues = spectral.eigenvalues;
let eigenvectors = spectral.eigenvectors;

let total_variance = eigenvalues[0] + eigenvalues[1];
let var_ratio_1 = (eigenvalues[0] / total_variance) * 100.0;
let var_ratio_2 = (eigenvalues[1] / total_variance) * 100.0;

println("\nPrincipal Components:");
println("  PC1: lambda = " + str(round(eigenvalues[0] * 1000.0) / 1000.0) +
        " (Explained Variance: " + str(round(var_ratio_1 * 10.0) / 10.0) + "%)");
println("       Eigenvector: [" + str(round(eigenvectors[0][0] * 1000.0) / 1000.0) + ", " + str(round(eigenvectors[0][1] * 1000.0) / 1000.0) + "]");
println("  PC2: lambda = " + str(round(eigenvalues[1] * 1000.0) / 1000.0) +
        " (Explained Variance: " + str(round(var_ratio_2 * 10.0) / 10.0) + "%)");

// Step 5: Dimensionality Reduction (Project 2D -> 1D along PC1)
println("\nProjected 1D Representation (top 3 samples):");
let pc1 = eigenvectors[0];
let s = 0;
while s < 3 {
    let proj = (centered[s][0] * pc1[0]) + (centered[s][1] * pc1[1]);
    println("  Sample " + str(s + 1) + " -> " + str(round(proj * 1000.0) / 1000.0));
    s = s + 1;
}

println("\n[OK] PCA dimensionality reduction completed successfully.");
