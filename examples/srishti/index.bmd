let Parser = parse_pkg.Parser;
let new_parser = parse_pkg.new_parser;
let create_parser = parse_pkg.create_parser;
let parse_program = parse_pkg.parse_program;

// Convenience function to parse Srishti source code into an AST Program
let parse = fn(source_code, filename) {
    let l = new_lexer(source_code, filename);
    let p = new_parser(l);
    return p.parse_program();
};

