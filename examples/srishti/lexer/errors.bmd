// Srishti Programming Language :: Lexical Diagnostics and Error Formatter
// Part of Phase 3: The Srishti (सृष्टि) Programming Language Architecture
// Formats high-precision compiler diagnostics with source line snippets and pointer arrows (^~~~~).

// Helper function to repeat a character or string n times
let repeat_str = fn(s, count) {
    if count <= 0 {
        return "";
    }
    let res = "";
    let i = 0;
    while i < count {
        res = res + s;
        i = i + 1;
    }
    return res;
};

// Extracts a single 1-based source line from raw source text
let extract_source_line = fn(source, target_line) {
    if source == null || len(source) == 0 || target_line < 1 {
        return "";
    }
    let lines = split(source, "\n");
    if target_line <= len(lines) {
        let l = lines[target_line - 1];
        return trim(l, "\r");
    }
    return "";
};

// Pads integer line numbers to a minimum column width
let pad_line_number = fn(line_num, width) {
    let s = str(line_num);
    while len(s) < width {
        s = " " + s;
    }
    return s;
};

// Generates a formatted multi-line diagnostic string with source snippet and pointer
let format_lex_error = fn(message, filename, line, col, source_line, span_len) {
    if filename == null || filename == "" {
        filename = "<input>";
    }
    if span_len == null || span_len < 1 {
        span_len = 1;
    }

    let line_str = str(line);
    let col_str = str(col);
    let num_width = len(line_str);
    if num_width < 2 {
        num_width = 2;
    }
    let gutter_margin = repeat_str(" ", num_width);

    // Build arrow pointer
    let pointer_indent = col - 1;
    if pointer_indent < 0 {
        pointer_indent = 0;
    }
    let leading_spaces = repeat_str(" ", pointer_indent);
    let pointer = "^";
    if span_len > 1 {
        pointer = pointer + repeat_str("~", span_len - 1);
    }

    let out = "✦ error[LexicalError]: " + message + "\n";
    out = out + "  --> " + filename + ":" + line_str + ":" + col_str + "\n";
    out = out + "   " + gutter_margin + " |\n";
    out = out + "   " + pad_line_number(line, num_width) + " | " + source_line + "\n";
    out = out + "   " + gutter_margin + " | " + leading_spaces + pointer;

    return out;
};

// LexError struct encapsulates a single diagnostic event with coordinate and source context
struct LexError {
    message,
    filename,
    line,
    col,
    span_len,
    source_line,

    // Returns the fully formatted multi-line diagnostic text
    fn format() {
        return format_lex_error(message, filename, line, col, source_line, span_len);
    }

    // Short one-line summary
    fn to_string() {
        let fn_name = filename;
        if fn_name == null || fn_name == "" {
            fn_name = "<input>";
        }
        return "[ERROR] Lexical Error: " + message + " at " + fn_name + ":" + str(line) + ":" + str(col);
    }

    // Inspection alias
    fn inspect() {
        return to_string();
    }
}

// Constructor function creating LexError instances
let new_lex_error = fn(message, filename, line, col, source_line, span_len) {
    if span_len == null || span_len < 1 {
        span_len = 1;
    }
    return LexError(message, filename, line, col, span_len, source_line);
};
