// English Operator Keywords
let TOKEN_PLUS = tok_pkg.TOKEN_PLUS;
let TOKEN_MINUS = tok_pkg.TOKEN_MINUS;
let TOKEN_TIMES = tok_pkg.TOKEN_TIMES;
let TOKEN_DIVIDED_BY = tok_pkg.TOKEN_DIVIDED_BY;
let TOKEN_MODULO = tok_pkg.TOKEN_MODULO;
