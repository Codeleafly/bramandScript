// examples/pipeline_bench/main.bmd
// BramandScript Real-World Dogfooding Application :: Buffer & Stream Pipe Benchmark
// 100% Pure BramandScript using std/buffer and std/io for high-throughput binary streaming.

import "std/buffer" as buffer;
import "std/io" as io;

let Buffer = buffer.Buffer;

let print_banner = fn() {
    println("✦ BramandScript Buffer Stream Pipeline Benchmark");
    println("────────────────────────────────────────────────────────────────────────────");
};

// Benchmark 1: Buffer Allocation & Binary Numeric Codecs
let bench_binary_codecs = fn(iterations) {
    println("· [1/3] Benchmarking Binary Numeric Codecs (UInt32 / Double BE/LE)...");
    let buf = Buffer.alloc(32);

    let i = 0;
    while (i < iterations) {
        buf.write_uint32_be(0xDEADBEEF, 0);
        buf.write_uint32_le(0x12345678, 4);
        buf.write_double_be(3.141592653589793, 8);
        buf.write_double_le(2.718281828459045, 16);

        let u32be = buf.read_uint32_be(0);
        let u32le = buf.read_uint32_le(4);
        let f64be = buf.read_double_be(8);
        let f64le = buf.read_double_le(16);

        assert_eq(u32be, 0xDEADBEEF);
        assert_eq(u32le, 0x12345678);
        i = i + 1;
    }

    println("  [OK] Completed " + str(iterations) + " binary encode/decode cycles with 100% precision.");
};

// Benchmark 2: Memory Copy & Slice Operations
let bench_memory_copy = fn(chunk_size, iterations) {
    println("· [2/3] Benchmarking Memory Copy & Slicing (" + str(chunk_size / 1024) + " KB chunks)...");
    let src = Buffer.alloc(chunk_size);
    src.fill(0xAA, 0, chunk_size);

    let dst = Buffer.alloc(chunk_size);

    let i = 0;
    let total_bytes_copied = 0;
    while (i < iterations) {
        let copied = src.copy(dst, 0, 0, chunk_size);
        total_bytes_copied = total_bytes_copied + copied;
        i = i + 1;
    }

    // Verify destination matches source
    assert_eq(Buffer.compare(src, dst), 0);
    println("  [OK] Copied " + str(total_bytes_copied / 1024) + " KB across " + str(iterations) + " iterations (Verified 0 byte discrepancies).");
};

// Benchmark 3: End-to-End Stream Piping (io.pipe)
let bench_stream_pipe = fn(data_size, chunk_size) {
    println("· [3/3] Benchmarking Stream Piping: io.pipe(BufferReader, BufferWriter)...");
    println("  Payload size: " + str(data_size / 1024) + " KB, Chunk size: " + str(chunk_size) + " bytes");

    // 1. Generate structured test payload
    let src_buf = Buffer.alloc(data_size);
    let p = 0;
    while (p <= data_size - 4) {
        src_buf.write_uint32_be(p, p);
        p = p + 4;
    }

    // 2. Initialize Readable and Writable streams
    let reader = io.BufferReader(src_buf);
    let writer = io.BufferWriter();

    // 3. Pipe data through stream combinator
    let chunk_count = 0;
    let piped_bytes = io.pipe(reader, writer, {
        "chunk_size": chunk_size,
        "on_chunk": fn(c) {
            chunk_count = chunk_count + 1;
        }
    });

    assert_eq(piped_bytes, data_size);
    assert_eq(reader.is_eof(), true);

    // 4. Extract sink buffer and verify 100% byte integrity
    let dst_buf = writer.to_buffer();
    assert_eq(dst_buf.length, data_size);
    assert_eq(Buffer.compare(src_buf, dst_buf), 0);

    // Verify first and last uint32 words match
    assert_eq(dst_buf.read_uint32_be(0), 0);
    let last_offset = data_size - 4;
    assert_eq(dst_buf.read_uint32_be(last_offset), last_offset);

    println("  [OK] Stream piped " + str(piped_bytes) + " bytes across " + str(chunk_count) + " stream chunks.");
    println("  [OK] Buffer byte comparison verified 100% data integrity.");
};

let main = fn() {
    print_banner();

    // 1. Numeric Codecs: 5,000 cycles
    bench_binary_codecs(5000);

    // 2. Memory Copy: 64 KB * 50 = 3,200 KB
    bench_memory_copy(65536, 50);

    // 3. Stream Piping: 256 KB via 4096-byte stream chunks
    bench_stream_pipe(262144, 4096);

    println("────────────────────────────────────────────────────────────────────────────");
    println("✦ Buffer stream pipeline benchmark completed successfully!");
};

main();
