// examples/08_test_suite.bmd
// BramandScript Native Testing Framework Demonstration

describe("Arithmetic and Logic", fn() {
        test("Integer operations", fn() {
                assert_eq(10 + 20, 30);
                assert_ne(10, 20);
        });

        test("Boolean expressions", fn() {
                assert(true);
                assert(!(false));
        });
});

describe("Collections and Strings", fn() {
        test("Array manipulation", fn() {
                let list = [1, 2, 3];
                list = push(list, 4);
                assert_eq(len(list), 4);
                assert_eq(pop(list), 4);
        });

        test("Hash map access", fn() {
                let map = {"status": "ok", "code": 200};
                assert_eq(map["status"], "ok");
                assert_eq(map["code"], 200);
        });
});
