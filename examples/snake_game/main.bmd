// main.bmd - CLI Entry Point for BramandScript Modular Snake Game

import "game.bmd"

fn print_banner() {
    println(color("cyan", styled("============================================================", "bold")));
    println(color("green", styled("  ✦ BRAMAND SCRIPT MODULAR SNAKE GAME ENGINE ✦", "bold")));
    println(color("cyan", styled("============================================================", "bold")));
    println("Engine: Pure Bytecode Virtual Machine with Modular Architecture");
    println("Standard Library: 100% Go stdlib | Zero External Dependencies\n");
}

fn print_usage() {
    println("Usage: bmd run examples/snake_game/main.bmd [options]");
    println("\nGame Modes:");
    println("  (default)          Play real-time arcade snake with Arrow keys / WASD");
    println("  --ai, --autoplay   Run autonomous heuristic AI solver");
    println("  --demo             Run fast AI simulation (20 ticks, 30ms)");
    println("\nSpeed Presets:");
    println("  --slow, -s         Relaxed pace (260ms per tick)");
    println("  --normal           Classic Nokia/arcade pace (190ms per tick - default)");
    println("  --fast, -f         Fast arcade pace (120ms per tick)");
    println("  --turbo            Extreme arcade speed (75ms per tick)");
    println("  --speed=<ms>       Custom tick delay in milliseconds (e.g. --speed=220)");
    println("\nGeneral:");
    println("  --help, -h         Show this help documentation\n");
}

fn main() {
    let cli_args = args();
    let is_ai = false;
    let is_demo = false;
    let delay = 190;
    let max_ticks = 1000;
    let width = 20;
    let height = 10;

    for arg in cli_args {
        if arg == "--help" || arg == "-h" {
            print_banner();
            print_usage();
            return;
        } else if arg == "--ai" || arg == "--autoplay" {
            is_ai = true;
            max_ticks = 200;
        } else if arg == "--demo" {
            is_ai = true;
            is_demo = true;
            max_ticks = 20;
            delay = 30;
        } else if arg == "--slow" || arg == "-s" {
            delay = 260;
        } else if arg == "--normal" {
            delay = 190;
        } else if arg == "--fast" || arg == "-f" {
            delay = 120;
        } else if arg == "--turbo" {
            delay = 75;
        } else {
            let parts = split(arg, "=");
            if len(parts) == 2 {
                if parts[0] == "--speed" || parts[0] == "--delay" {
                    let custom_delay = int(parts[1]);
                    if custom_delay > 0 {
                        delay = custom_delay;
                    }
                }
            }
        }
    }

    print_banner();

    let game = create_game(width, height);

    if is_ai {
        println(color("green", "Starting Autonomous AI Demonstration Mode..."));
        println("The heuristic pathfinding agent will steer the snake automatically!");
        sleep(600);
        game_run_ai(game, max_ticks, delay);
    } else {
        println(color("yellow", "Starting Real-Time Arcade Player Mode!"));
        println("Use Arrow keys (↑/↓/←/→) or W/A/S/D to steer. Space to pause, Q to quit.");
        sleep(800);
        game_run_interactive(game, max_ticks, delay);
    }

    println(color("cyan", "\n✦ Thank you for playing BramandScript Snake! ✦"));
}

main();
